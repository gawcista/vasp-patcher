+       IF (WINT_MODEL/=WINT_MODEL_RK2D) &
+          WRITE(IUNIT,'(A,ES24.16)') '# WINT_Z0 [Angstrom along the declared normal]: ',WINT_Z0
+       WRITE(IUNIT,'(A,3ES24.16)') '# WINT_NORMAL [Cartesian unit vector]: ',WINT_NORMAL_USED
+       WRITE(IUNIT,'(A,ES24.16)') '# Normal integration cell length [Angstrom]: ',WINT_LAYER_LZ
