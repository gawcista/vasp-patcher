+               CASE(WINT_MODEL_DUAL_GATE)
+                  WRITE(IU6,'(A)') ' WINT_KERNEL: DUAL_GATE'
+               CASE(WINT_MODEL_DUAL_GATE_RADIAL)
+                  WRITE(IU6,'(A)') ' WINT_KERNEL: DUAL_GATE_RADIAL'
+                  WRITE(IU6,'(A,ES16.8)') ' WINT_OHNO_A [Angstrom]: ',WINT_OHNO_A
