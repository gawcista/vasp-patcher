+  SUBROUTINE WINT_LAYER_APPLY_NATIVE(WQ,LATT_CUR,DENSITY,WORK,IERR,MESSAGE,AUDIT_UNIT)
+    TYPE(wavedes1), INTENT(IN) :: WQ
+    TYPE(latt), INTENT(IN) :: LATT_CUR
+    COMPLEX(q), INTENT(IN) :: DENSITY(:,:)
+    COMPLEX(q), INTENT(OUT) :: WORK(:,:)
+    INTEGER, INTENT(OUT) :: IERR
+    CHARACTER(*), INTENT(OUT) :: MESSAGE
+    INTEGER, INTENT(IN), OPTIONAL :: AUDIT_UNIT
+    INTEGER, ALLOCATABLE :: IG(:,:)
+    INTEGER :: IOS,NG
+    REAL(q) :: NATIVE_SCALE
+    IERR=0;MESSAGE='';NG=SIZE(DENSITY,1)
+    IF (GRIDHF%NPLWV/=WQ%GRID%NPLWV) THEN
+       IERR=1;MESSAGE='Layered projection requires matching native density and response FFT normalizations';RETURN
+    ENDIF
+    IF (NG/=WQ%NGVECTOR.OR.ANY(SHAPE(WORK)/=SHAPE(DENSITY))) THEN
+       IERR=1;MESSAGE='Layered projection density dimensions do not match the native response basis';RETURN
+    ENDIF
+    ALLOCATE(IG(3,NG),STAT=IOS)
+    IF (IOS/=0) THEN
+       IERR=2;MESSAGE='Layered projection G-index allocation failed';RETURN
+    ENDIF
+    IG(1,:)=WQ%IGX(1:NG);IG(2,:)=WQ%IGY(1:NG);IG(3,:)=WQ%IGZ(1:NG)
+    NATIVE_SCALE=EDEPS/(4*PI*LATT_CUR%OMEGA*REAL(WQ%GRID%NPLWV,q))
+    IF (PRESENT(AUDIT_UNIT)) THEN
+       CALL wlayer_apply(IG,WQ%VKPT,DENSITY,NATIVE_SCALE,WORK,IERR,MESSAGE,AUDIT_UNIT)
+    ELSE
+       CALL wlayer_apply(IG,WQ%VKPT,DENSITY,NATIVE_SCALE,WORK,IERR,MESSAGE)
+    ENDIF
+    DEALLOCATE(IG)
+  END SUBROUTINE WINT_LAYER_APPLY_NATIVE
+
+  SUBROUTINE WINT_AUDIT_LAYER_QBLOCK(WDES,WQ,NQ,NW,DENSITY,WORK,MATRIX,SCALE,LATT_CUR)
+    USE iso_fortran_env, ONLY: int32
+    TYPE(wavedes), INTENT(IN) :: WDES
+    TYPE(wavedes1), INTENT(IN) :: WQ
+    TYPE(latt), INTENT(IN) :: LATT_CUR
+    INTEGER, INTENT(IN) :: NQ,NW
+    REAL(q), INTENT(IN) :: SCALE
+    COMPLEX(q), INTENT(IN) :: DENSITY(:,:)
+    COMPLEX(q), INTENT(INOUT) :: WORK(:,:)
+    GDEF, INTENT(IN) :: MATRIX(:,:,:,:)
+    CHARACTER(1024) :: DIRECTORY,FILENAME,MESSAGE
+    INTEGER :: STATUS,IUNIT,IOS,IERR,LAYOUT(9),NG,AUDIT_FORMAT
+#ifdef gammareal
+    RETURN
+#else
+    CALL GET_ENVIRONMENT_VARIABLE('VASP_WINT_AUDIT_DIR',DIRECTORY,STATUS=STATUS)
+    IF (STATUS/=0.OR.LEN_TRIM(DIRECTORY)==0) RETURN
+    NG=SIZE(DENSITY,1)
+    LAYOUT=1;LAYOUT(1)=WINT_MODEL
+    IF (ASSOCIATED(WDES%COMM_KINTER)) LAYOUT(2:3)=[WDES%COMM_KINTER%NODE_ME,WDES%COMM_KINTER%NCPU]
+    IF (ASSOCIATED(WDES%COMM_INB)) LAYOUT(4:5)=[WDES%COMM_INB%NODE_ME,WDES%COMM_INB%NCPU]
+    IF (ASSOCIATED(WDES%COMM_INTER)) LAYOUT(6:7)=[WDES%COMM_INTER%NODE_ME,WDES%COMM_INTER%NCPU]
+    IF (ASSOCIATED(WDES%COMM)) LAYOUT(8:9)=[WDES%COMM%NODE_ME,WDES%COMM%NCPU]
+    WRITE(FILENAME,'(A,A,I5.5,A,I5.5,A)') TRIM(DIRECTORY),'/q',NQ,'-rank',WDES%COMM%NODE_ME,'.bin'
+    OPEN(NEWUNIT=IUNIT,FILE=TRIM(FILENAME),ACCESS='STREAM',FORM='UNFORMATTED',STATUS='REPLACE',IOSTAT=IOS)
+    IF (IOS/=0) CALL vtutor%error('Could not open explicitly requested layered q-block diagnostic')
+    ! The radial model adds its Ohno length after the common scalar header.
+    AUDIT_FORMAT=MERGE(4,3,WINT_MODEL==WINT_MODEL_DUAL_GATE_RADIAL)
+    WRITE(IUNIT) INT([AUDIT_FORMAT,NG,NW,NQ,WDES%NKPTS,GRIDHF%NPLWV,WQ%GRID%NPLWV,LAYOUT,WINT_BOUNDARY],int32)
+    WRITE(IUNIT) WQ%VKPT,SCALE,WINT_KAPPA,WINT_EPS,WINT_R0,WINT_GATE_D,WINT_Z0,WINT_LAYER_LZ
+    IF (WINT_MODEL==WINT_MODEL_DUAL_GATE_RADIAL) WRITE(IUNIT) WINT_OHNO_A
+    WRITE(IUNIT) INT(WQ%IGX(1:NG),int32),INT(WQ%IGY(1:NG),int32),INT(WQ%IGZ(1:NG),int32)
+    WRITE(IUNIT) DENSITY,MATRIX
+    CALL WINT_LAYER_APPLY_NATIVE(WQ,LATT_CUR,DENSITY,WORK,IERR,MESSAGE,AUDIT_UNIT=IUNIT)
+    IF (IERR/=0) CALL vtutor%error('Layered q-block diagnostic failed: '//TRIM(MESSAGE))
+    CLOSE(IUNIT)
+#endif
+  END SUBROUTINE WINT_AUDIT_LAYER_QBLOCK
+
+  SUBROUTINE WINT_AUDIT_QBLOCK(WDES,WQ,NQ,NW,TARGET,DENSITY,WORK,MATRIX,SCALE,LATT_CUR)
+    USE iso_fortran_env, ONLY: int32
+    TYPE(wavedes), INTENT(IN) :: WDES
+    TYPE(wavedes1), INTENT(IN) :: WQ
+    TYPE(latt), INTENT(IN) :: LATT_CUR
+    INTEGER, INTENT(IN) :: NQ,NW
+    REAL(q), INTENT(IN) :: TARGET(:),SCALE
+    COMPLEX(q), INTENT(IN) :: DENSITY(:,:)
+    COMPLEX(q), INTENT(INOUT) :: WORK(:,:)
+    GDEF, INTENT(IN) :: MATRIX(:,:,:,:)
+    GDEF :: FULL_BARE(NW,NW,NW,NW)
+    REAL(q), ALLOCATABLE :: BARE(:)
+    CHARACTER(1024) :: DIRECTORY,FILENAME
+    INTEGER :: STATUS,IUNIT,IOS,I,LAYOUT(9)
+#ifdef gammareal
+    RETURN
+#else
+    CALL GET_ENVIRONMENT_VARIABLE('VASP_WINT_AUDIT_DIR',DIRECTORY,STATUS=STATUS)
+    IF (STATUS/=0.OR.LEN_TRIM(DIRECTORY)==0) RETURN
+    ALLOCATE(BARE(SIZE(TARGET)),STAT=IOS)
+    IF (IOS/=0) CALL vtutor%error('Full-density q-block diagnostic allocation failed')
+    CALL SET_GFAC_WAVEFUN_WS(WQ,LATT_CUR,BARE)
+    WORK=DENSITY
+    DO I=1,NW*NW
+       CALL APPLY_GFAC_WAVEFUN(WQ,WORK(1,I),BARE)
+    ENDDO
+    CALL GGEMM(trans,'N',NW*NW,NW*NW,m_ SIZE(TARGET),one,WORK(1,1),m_ SIZE(WORK,1), &
+       DENSITY(1,1),m_ SIZE(DENSITY,1),zero,FULL_BARE(1,1,1,1),NW*NW)
+    LAYOUT=1
+    LAYOUT(1)=WINT_MODEL
+    IF (ASSOCIATED(WDES%COMM_KINTER)) LAYOUT(2:3)=[WDES%COMM_KINTER%NODE_ME,WDES%COMM_KINTER%NCPU]
+    IF (ASSOCIATED(WDES%COMM_INB)) LAYOUT(4:5)=[WDES%COMM_INB%NODE_ME,WDES%COMM_INB%NCPU]
+    IF (ASSOCIATED(WDES%COMM_INTER)) LAYOUT(6:7)=[WDES%COMM_INTER%NODE_ME,WDES%COMM_INTER%NCPU]
+    IF (ASSOCIATED(WDES%COMM)) LAYOUT(8:9)=[WDES%COMM%NODE_ME,WDES%COMM%NCPU]
+    WRITE(FILENAME,'(A,A,I5.5,A,I5.5,A)') TRIM(DIRECTORY),'/q',NQ,'-rank',WDES%COMM%NODE_ME,'.bin'
+    OPEN(NEWUNIT=IUNIT,FILE=TRIM(FILENAME),ACCESS='STREAM',FORM='UNFORMATTED',STATUS='REPLACE',IOSTAT=IOS)
+    IF (IOS/=0) CALL vtutor%error('Could not open explicitly requested full-density q-block diagnostic')
+    WRITE(IUNIT) INT([2,SIZE(TARGET),NW,NQ,WDES%NKPTS,GRIDHF%NPLWV,WQ%GRID%NPLWV,LAYOUT],int32)
+    WRITE(IUNIT) WQ%VKPT,SCALE,WINT_KAPPA,WINT_EPS
+    WRITE(IUNIT) WQ%IGX(1:SIZE(TARGET)),WQ%IGY(1:SIZE(TARGET)),WQ%IGZ(1:SIZE(TARGET))
+    WRITE(IUNIT) BARE,TARGET,DENSITY,FULL_BARE,MATRIX
+    CLOSE(IUNIT)
+    DEALLOCATE(BARE)
+#endif
+  END SUBROUTINE
