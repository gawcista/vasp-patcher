+         IF (INDEX(PARSE_ERRORS,'TAG WINT_GATE_D IS NOT ASSIGNED.')>0) &
+            CALL vtutor%error('WINT_GATE_D requires one finite positive length in Angstrom')
+         IF (INDEX(PARSE_ERRORS,'TAG WINT_OHNO_A IS NOT ASSIGNED.')>0) &
