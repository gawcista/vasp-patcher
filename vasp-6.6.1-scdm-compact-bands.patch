+#include "symbol.inc"
+! Original bounded-workspace raw PAW density adapter; external native trial.
+MODULE wint_paw
+ USE prec
+ USE wave, ONLY:wavedes1,wavefun1
+ USE pseudo, ONLY:potcar
+ USE poscar, ONLY:type_info
+ USE lattice, ONLY:latt
+ USE asa, ONLY:SETYLM,YLM3LOOKUP,LMAXCG,INDCG,JS,YLM3
+ USE iso_fortran_env, ONLY:int64
+ USE,INTRINSIC::ieee_arithmetic,ONLY:ieee_is_finite
+ IMPLICIT NONE
+ PRIVATE
+ PUBLIC::wint_paw_context,wint_paw_accumulator,wint_paw_prepare,wint_paw_reset,wint_paw_info
+ PUBLIC::wint_paw_begin_accumulator,wint_paw_accumulate_batch,wint_paw_add_accumulated
+ PUBLIC::wint_paw_reset_accumulator,wint_paw_add_density,wint_paw_memory_info
+ INTERFACE
+  SUBROUTINE MRG_PROJ(wd,global_proj,local_proj)
+   USE prec
+   USE wave,ONLY:wavedes1
+   TYPE(wavedes1)::wd
+   GDEF::global_proj(wd%NPRO_TOT),local_proj(wd%NPRO)
+  END SUBROUTINE
+ END INTERFACE
+ REAL(q),PARAMETER::PI_W=ACOS(-1._q),TRUNC_TOL=1.e-15_q
+ INTEGER,PARAMETER::MAX_DEGREE=512,MAX_GBLOCK=2048,MAX_ATOMBLOCK=128
+ INTEGER(int64),PARAMETER::MEMORY_LIMIT=536870912_int64,PLAN_RESERVE=16777216_int64
+ INTEGER(int64),SAVE::resident=0,highwater=PLAN_RESERVE,next_generation=0
+ TYPE paw_species
+  INTEGER::nlm=0,ne=0,nrad=0,natom=0,degree=0,lmax=0
+  INTEGER,ALLOCATABLE::ell(:),lm(:),rad(:),rc1(:),rc2(:),rell(:),atoms(:)
+  COMPLEX(q),ALLOCATABLE::cg(:,:)
+  REAL(q),ALLOCATABLE::cheb(:,:),head(:),bound(:)
+  REAL(q)::check_error=0
+ END TYPE
+ TYPE accumulator_species
+  COMPLEX(q),ALLOCATABLE::coef(:,:,:)
+ END TYPE
+ TYPE wint_paw_context
+  PRIVATE
+  LOGICAL::ready=.false.
+  INTEGER::ng=0,nions=0,stride=0,lmax=0,maxne=0,maxrad=0,maxatom=0,maxnlm=0
+  INTEGER(int64)::bytes=0,generation=0
+  REAL(q)::qfrac(3)=0,b(3,3)=0,nfft=0,qmax=0
+  INTEGER,ALLOCATABLE::ityp(:),offset(:),atomslot(:),gvec(:,:)
+  REAL(q),ALLOCATABLE::pos(:,:)
+  TYPE(paw_species),ALLOCATABLE::species(:)
+ CONTAINS
+  FINAL::final_context
+ END TYPE
+ TYPE wint_paw_accumulator
+  PRIVATE
+  LOGICAL::ready=.false.
+  INTEGER::npairs=0,n1=0,n4=0,batches=0
+  INTEGER(int64)::bytes=0,generation=0
+  TYPE(accumulator_species),ALLOCATABLE::species(:)
+ CONTAINS
+  FINAL::final_accumulator
+ END TYPE
+CONTAINS
+ LOGICAL FUNCTION hold_bytes(n)
+  INTEGER(int64),INTENT(IN)::n
+  hold_bytes=.false.
+  IF(n<0.OR.n>MEMORY_LIMIT-PLAN_RESERVE)RETURN
+  IF(resident>MEMORY_LIMIT-PLAN_RESERVE-n)RETURN
+  resident=resident+n;highwater=MAX(highwater,resident+PLAN_RESERVE);hold_bytes=.true.
+ END FUNCTION
+ SUBROUTINE release_bytes(n)
+  INTEGER(int64),INTENT(IN)::n
+  IF(n<0.OR.n>resident)THEN
+   CALL M_stop('WINT PAW workspace ownership ledger violated')
+   RETURN
+  ENDIF
+  resident=resident-n
+ END SUBROUTINE
+ SUBROUTINE wint_paw_memory_info(current,peak,limit)
+  INTEGER(int64),INTENT(OUT)::current,peak,limit
+  current=resident+PLAN_RESERVE;peak=highwater;limit=MEMORY_LIMIT
+ END SUBROUTINE
+ SUBROUTINE wint_paw_reset(ctx)
+  TYPE(wint_paw_context),INTENT(INOUT)::ctx
+  IF(ALLOCATED(ctx%species))DEALLOCATE(ctx%species)
+  IF(ALLOCATED(ctx%ityp))DEALLOCATE(ctx%ityp)
+  IF(ALLOCATED(ctx%offset))DEALLOCATE(ctx%offset)
+  IF(ALLOCATED(ctx%atomslot))DEALLOCATE(ctx%atomslot)
+  IF(ALLOCATED(ctx%pos))DEALLOCATE(ctx%pos)
+  IF(ALLOCATED(ctx%gvec))DEALLOCATE(ctx%gvec)
+  CALL release_bytes(ctx%bytes)
+  ctx%bytes=0;ctx%ready=.false.;ctx%generation=0;ctx%ng=0;ctx%stride=0;ctx%nions=0
+  ctx%nfft=0;ctx%qmax=0;ctx%lmax=0;ctx%maxne=0;ctx%maxrad=0;ctx%maxatom=0;ctx%maxnlm=0
+ END SUBROUTINE
+ SUBROUTINE final_context(ctx)
+  TYPE(wint_paw_context),INTENT(INOUT)::ctx
+  CALL wint_paw_reset(ctx)
+ END SUBROUTINE
+ SUBROUTINE wint_paw_reset_accumulator(acc)
+  TYPE(wint_paw_accumulator),INTENT(INOUT)::acc
+  IF(ALLOCATED(acc%species))DEALLOCATE(acc%species)
+  CALL release_bytes(acc%bytes)
+  acc%bytes=0;acc%ready=.false.;acc%generation=0;acc%npairs=0;acc%n1=0;acc%n4=0;acc%batches=0
+ END SUBROUTINE
+ SUBROUTINE final_accumulator(acc)
+  TYPE(wint_paw_accumulator),INTENT(INOUT)::acc
+  CALL wint_paw_reset_accumulator(acc)
+ END SUBROUTINE
+ SUBROUTINE wint_paw_info(ctx,ng,nunique,bytes,nfft,degree,truncation_bound,check_error)
+  TYPE(wint_paw_context),INTENT(IN)::ctx
+  INTEGER,INTENT(OUT)::ng,nunique
+  INTEGER(int64),INTENT(OUT)::bytes
+  REAL(q),INTENT(OUT)::nfft
+  INTEGER,OPTIONAL,INTENT(OUT)::degree
+  REAL(q),OPTIONAL,INTENT(OUT)::truncation_bound,check_error
+  INTEGER::nt,deg
+  REAL(q)::bound,err
+  ng=ctx%ng;nunique=-1;bytes=ctx%bytes;nfft=ctx%nfft;deg=0;bound=0;err=0
+  IF(ALLOCATED(ctx%species))THEN
+   DO nt=1,SIZE(ctx%species)
+    deg=MAX(deg,ctx%species(nt)%degree);err=MAX(err,ctx%species(nt)%check_error)
+    IF(ALLOCATED(ctx%species(nt)%bound))bound=MAX(bound,MAXVAL(ctx%species(nt)%bound))
+   ENDDO
+  ENDIF
+  IF(PRESENT(degree))degree=deg
+  IF(PRESENT(truncation_bound))truncation_bound=bound
+  IF(PRESENT(check_error))check_error=err
+ END SUBROUTINE
+ SUBROUTINE wint_paw_prepare(ctx,wgwq,p,t_info,latt_cur,ierr,message,nfft)
+  TYPE(wint_paw_context),INTENT(INOUT)::ctx
+  TYPE(wavedes1),INTENT(IN)::wgwq
+  TYPE(potcar),INTENT(IN)::p(:)
+  TYPE(type_info),INTENT(IN)::t_info
+  TYPE(latt),INTENT(IN)::latt_cur
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  INTEGER,OPTIONAL,INTENT(IN)::nfft
+  INTEGER::ng,nt,ni,ig,stat,slot
+  REAL(q)::cart(3)
+  INTEGER(int64)::bytes
+  ierr=0;message='';CALL wint_paw_reset(ctx)
+#ifdef gammareal
+  ierr=1;message='WINT PAW: gamma-real build unsupported';RETURN
+#endif
+  IF(.NOT.ASSOCIATED(wgwq%GRID).OR..NOT.ASSOCIATED(wgwq%VKPT))THEN
+   ierr=1;message='WINT PAW: missing response grid/q';RETURN
+  ENDIF
+  IF(wgwq%LGAMMA.OR.wgwq%LUSEINV.OR.wgwq%LSPIRAL)THEN
+   ierr=1;message='WINT PAW: require full complex unreduced response; no spiral';RETURN
+  ENDIF
+  ng=wgwq%NGVECTOR
+  IF(ng<0.OR.wgwq%GRID%NPLWV<=0.OR.SIZE(wgwq%VKPT)<3)THEN
+   ierr=1;message='WINT PAW: invalid response dimensions';RETURN
+  ENDIF
+  IF(.NOT.ASSOCIATED(wgwq%IGX).OR..NOT.ASSOCIATED(wgwq%IGY).OR..NOT.ASSOCIATED(wgwq%IGZ))THEN
+   ierr=1;message='WINT PAW: missing G indices';RETURN
+  ENDIF
+  IF(MIN(SIZE(wgwq%IGX),SIZE(wgwq%IGY),SIZE(wgwq%IGZ))<ng)THEN
+   ierr=1;message='WINT PAW: short G indices';RETURN
+  ENDIF
+  IF(.NOT.ALL(ieee_is_finite(wgwq%VKPT(:3))).OR..NOT.ALL(ieee_is_finite(latt_cur%B)))THEN
+   ierr=1;message='WINT PAW: nonfinite reciprocal geometry';RETURN
+  ENDIF
+  IF(t_info%NTYP<1.OR.SIZE(p)<t_info%NTYP.OR.t_info%NIONS<0)THEN
+   ierr=1;message='WINT PAW: invalid atom/species dimensions';RETURN
+  ENDIF
+  IF(.NOT.ASSOCIATED(t_info%ITYP).OR..NOT.ASSOCIATED(t_info%POSION).OR..NOT.ASSOCIATED(t_info%VCA))THEN
+   ierr=1;message='WINT PAW: missing atom/type/VCA descriptors';RETURN
+  ENDIF
+  IF(SIZE(t_info%ITYP)<t_info%NIONS.OR.SIZE(t_info%POSION,1)/=3.OR.SIZE(t_info%POSION,2)<t_info%NIONS)THEN
+   ierr=1;message='WINT PAW: inconsistent atom descriptors';RETURN
+  ENDIF
+  IF(SIZE(t_info%VCA)<t_info%NTYP)THEN
+   ierr=1;message='WINT PAW: short VCA descriptor';RETURN
+  ENDIF
+  IF(ANY(t_info%VCA(:t_info%NTYP)/=1._q))THEN
+   ierr=1;message='WINT PAW: VCA weights other than one unsupported';RETURN
+  ENDIF
+  IF(ANY(t_info%ITYP(:t_info%NIONS)<1).OR.ANY(t_info%ITYP(:t_info%NIONS)>t_info%NTYP).OR. &
+       .NOT.ALL(ieee_is_finite(t_info%POSION(:,:t_info%NIONS))))THEN
+   ierr=1;message='WINT PAW: invalid atom types/positions';RETURN
+  ENDIF
+  ctx%ng=ng;ctx%nions=t_info%NIONS;ctx%qfrac=wgwq%VKPT(:3);ctx%b=latt_cur%B;ctx%nfft=REAL(wgwq%GRID%NPLWV,q)
+  IF(PRESENT(nfft))THEN
+   IF(nfft<=0)THEN
+    ierr=1;message='WINT PAW: density NFFT must be positive';RETURN
+   ENDIF
+   ctx%nfft=REAL(nfft,q)
+  ENDIF
+  bytes=12_int64*ng+40_int64*ctx%nions+4096_int64*(t_info%NTYP+1)
+  IF(.NOT.hold_bytes(bytes))THEN
+   ierr=2;message='WINT PAW: context exceeds total 512MiB workspace limit';RETURN
+  ENDIF
+  ctx%bytes=bytes
+  ALLOCATE(ctx%species(t_info%NTYP),ctx%ityp(ctx%nions),ctx%offset(ctx%nions),ctx%atomslot(ctx%nions), &
+       ctx%pos(3,ctx%nions),ctx%gvec(3,ng),STAT=stat)
+  IF(stat/=0)THEN
+   ierr=2;message='WINT PAW: context allocation failed';CALL wint_paw_reset(ctx);RETURN
+  ENDIF
+  ctx%ityp=t_info%ITYP(:ctx%nions);ctx%pos=t_info%POSION(:,:ctx%nions);ctx%stride=0;ctx%qmax=0
+  ctx%lmax=0;ctx%maxne=0;ctx%maxrad=0;ctx%maxatom=0;ctx%maxnlm=0
+  DO ig=1,ng
+   ctx%gvec(:,ig)=[wgwq%IGX(ig),wgwq%IGY(ig),wgwq%IGZ(ig)]
+   cart=2*PI_W*MATMUL(ctx%b,REAL(ctx%gvec(:,ig),q)+ctx%qfrac)
+   IF(.NOT.ALL(ieee_is_finite(cart)).OR..NOT.ieee_is_finite(SUM(cart*cart)))THEN
+    ierr=1;message='WINT PAW: reciprocal norm overflow';EXIT
+   ENDIF
+   ctx%qmax=MAX(ctx%qmax,SQRT(SUM(cart*cart)))
+  ENDDO
+  IF(ierr==0)THEN
+   DO nt=1,t_info%NTYP
+    ctx%species(nt)%natom=COUNT(ctx%ityp==nt)
+    ALLOCATE(ctx%species(nt)%atoms(ctx%species(nt)%natom),STAT=stat)
+    IF(stat/=0)THEN
+     ierr=2;message='WINT PAW: atom-map allocation failed';EXIT
+    ENDIF
+    slot=0
+    DO ni=1,ctx%nions
+     IF(ctx%ityp(ni)==nt)THEN
+      slot=slot+1;ctx%species(nt)%atoms(slot)=ni;ctx%atomslot(ni)=slot
+     ENDIF
+    ENDDO
+    CALL build_species(ctx%species(nt),p(nt),ctx%qmax,bytes,ierr,message)
+    IF(ierr/=0)EXIT
+    ctx%bytes=ctx%bytes+bytes
+    ctx%lmax=MAX(ctx%lmax,ctx%species(nt)%lmax);ctx%maxne=MAX(ctx%maxne,ctx%species(nt)%ne)
+    ctx%maxrad=MAX(ctx%maxrad,ctx%species(nt)%nrad);ctx%maxatom=MAX(ctx%maxatom,ctx%species(nt)%natom)
+    ctx%maxnlm=MAX(ctx%maxnlm,ctx%species(nt)%nlm)
+   ENDDO
+  ENDIF
+  IF(ierr/=0)THEN
+   CALL wint_paw_reset(ctx);RETURN
+  ENDIF
+  DO ni=1,ctx%nions
+   ctx%offset(ni)=ctx%stride;ctx%stride=ctx%stride+p(ctx%ityp(ni))%LMMAX
+  ENDDO
+  next_generation=next_generation+1;ctx%generation=next_generation;ctx%ready=.true.
+  message='raw PAW factorized Chebyshev context ready; no dense G-entry cache'
+ END SUBROUTINE
+ REAL(q) FUNCTION tail_bound(a,n)
+  REAL(q),INTENT(IN)::a
+  INTEGER,INTENT(IN)::n
+  REAL(q)::logterm
+  tail_bound=0
+  IF(a==0)RETURN
+  IF(a>=REAL(n+2,q))THEN
+   tail_bound=HUGE(1._q);RETURN
+  ENDIF
+  logterm=REAL(n+1,q)*LOG(a)-LOG_GAMMA(REAL(n+2,q))
+  IF(logterm>LOG(HUGE(1._q))-2)THEN
+   tail_bound=HUGE(1._q);RETURN
+  ENDIF
+  tail_bound=MAX(TINY(1._q),EXP(logterm))/(1-a/REAL(n+2,q))
+ END FUNCTION
+ REAL(q) FUNCTION cheb_one(coeff,x)
+  REAL(q),INTENT(IN)::coeff(0:),x
+  REAL(q)::b1,b2,b0
+  INTEGER::k
+  b1=0;b2=0
+  DO k=UBOUND(coeff,1),1,-1
+   b0=2*x*b1-b2+coeff(k);b2=b1;b1=b0
+  ENDDO
+  cheb_one=x*b1-b2+coeff(0)
+ END FUNCTION
+ SUBROUTINE build_species(s,p,qmax,booked,ierr,message)
+  TYPE(paw_species),INTENT(INOUT)::s
+  TYPE(potcar),INTENT(IN)::p
+  REAL(q),INTENT(IN)::qmax
+  INTEGER(int64),INTENT(OUT)::booked
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  INTEGER::nr,nc,ellmax,c1,c2,l,m,e,rid,n,deg,j,k,i,idx,ic,stat
+  INTEGER,ALLOCATABLE::base(:),lookup(:,:,:)
+  REAL(q),ALLOCATABLE::rho(:,:),sample(:,:),bessel(:,:),mass(:),bounds(:)
+  REAL(q)::x,qvalue,integral,error,weight
+  INTEGER(int64)::cache_bytes,work_bytes
+  ierr=0;message='';booked=0;s%nlm=p%LMMAX
+  IF(p%LMMAX<0.OR.p%LMAX<0)THEN
+   ierr=1;message='WINT PAW: negative projector dimensions';RETURN
+  ENDIF
+  IF(.NOT.ASSOCIATED(p%WAE).AND..NOT.ASSOCIATED(p%WPS))RETURN
+  IF(.NOT.ASSOCIATED(p%WAE).OR..NOT.ASSOCIATED(p%WPS).OR..NOT.ASSOCIATED(p%LPS).OR. &
+       .NOT.ASSOCIATED(p%R%R).OR..NOT.ASSOCIATED(p%R%SI))THEN
+   ierr=1;message='WINT PAW: incomplete raw radial data';RETURN
+  ENDIF
+  nr=p%R%NMAX;nc=p%LMAX
+  IF(nr<1.OR.nc<1.OR.SIZE(p%LPS)<nc)THEN
+   ierr=1;message='WINT PAW: invalid radial/channel dimensions';RETURN
+  ENDIF
+  IF(MIN(SIZE(p%WAE,1),SIZE(p%WPS,1),SIZE(p%R%R),SIZE(p%R%SI))<nr.OR.MIN(SIZE(p%WAE,2),SIZE(p%WPS,2))<nc)THEN
+   ierr=1;message='WINT PAW: truncated radial data';RETURN
+  ENDIF
+  IF(ANY(p%LPS(:nc)<0).OR.SUM(2*p%LPS(:nc)+1)/=p%LMMAX)THEN
+   ierr=1;message='WINT PAW: inconsistent angular projector layout';RETURN
+  ENDIF
+  ellmax=MAXVAL(p%LPS(:nc));s%lmax=2*ellmax
+  IF(LMAXCG<ellmax.OR.(s%lmax>2.AND.LMAXCG<s%lmax-1))THEN
+   ierr=1;message='WINT PAW: native Gaunt table lacks full raw angular bandwidth';RETURN
+  ENDIF
+  IF(.NOT.ALL(ieee_is_finite(p%R%R(:nr))).OR..NOT.ALL(ieee_is_finite(p%R%SI(:nr))).OR. &
+       .NOT.ALL(ieee_is_finite(p%WAE(:nr,:nc))).OR..NOT.ALL(ieee_is_finite(p%WPS(:nr,:nc))))THEN
+   ierr=1;message='WINT PAW: nonfinite radial data';RETURN
+  ENDIF
+  IF(ANY(p%R%R(:nr)<=0).OR.ANY(p%R%R(2:nr)<=p%R%R(:nr-1)))THEN
+   ierr=1;message='WINT PAW: require positive ordered radial grid';RETURN
+  ENDIF
+  s%ne=0;s%nrad=0
+  DO c1=1,nc
+   DO c2=c1,nc
+    DO l=ABS(p%LPS(c1)-p%LPS(c2)),p%LPS(c1)+p%LPS(c2),2
+     s%ne=s%ne+2*l+1;s%nrad=s%nrad+1
+    ENDDO
+   ENDDO
+  ENDDO
+  ! Reserve all maximum-degree construction arrays before allocating any of them.
+  work_bytes=8_int64*nr*(s%nrad+s%lmax+1)+8_int64*(MAX_DEGREE+1)*s%nrad &
+       +16_int64*s%nrad+4_int64*nc+4_int64*nc*nc*(s%lmax+1)**2
+  IF(.NOT.hold_bytes(work_bytes))THEN
+   ierr=2;message='WINT PAW: radial construction exceeds total 512MiB workspace';RETURN
+  ENDIF
+  ALLOCATE(rho(nr,s%nrad),sample(0:MAX_DEGREE,s%nrad),bessel(nr,0:s%lmax), &
+       mass(s%nrad),bounds(s%nrad),base(nc),lookup(nc,nc,(s%lmax+1)**2),STAT=stat)
+  IF(stat/=0)THEN
+   ierr=2;message='WINT PAW: radial construction allocation failed';GOTO 900
+  ENDIF
+  rid=0
+  DO c1=1,nc
+   DO c2=c1,nc
+    DO l=ABS(p%LPS(c1)-p%LPS(c2)),p%LPS(c1)+p%LPS(c2),2
+     rid=rid+1
+     DO i=1,nr
+      rho(i,rid)=(p%WAE(i,c1)*p%WAE(i,c2)-p%WPS(i,c1)*p%WPS(i,c2))*p%R%SI(i)
+      IF(.NOT.ieee_is_finite(rho(i,rid)))THEN
+       ierr=3;message='WINT PAW: raw radial-product overflow';GOTO 900
+      ENDIF
+     ENDDO
+    ENDDO
+   ENDDO
+  ENDDO
+  mass=0
+  DO rid=1,s%nrad
+   DO i=1,nr
+    mass(rid)=mass(rid)+ABS(rho(i,rid))
+   ENDDO
+  ENDDO
+  deg=16
+  IF(qmax==0)deg=0
+  DO
+   bounds=0
+   DO i=1,nr
+    weight=tail_bound(qmax*p%R%R(i)/4,deg)
+    DO rid=1,s%nrad
+     ! Factor 8 conservatively exceeds the exact-arithmetic interpolation bound4.
+     IF(ABS(rho(i,rid))>0)THEN
+      IF(weight>=HUGE(1._q)/MAX(1._q,8*ABS(rho(i,rid))))THEN
+       bounds(rid)=HUGE(1._q)
+      ELSE
+       integral=8*ABS(rho(i,rid))*weight
+       IF(bounds(rid)>HUGE(1._q)-integral)THEN
+        bounds(rid)=HUGE(1._q)
+       ELSE
+        bounds(rid)=bounds(rid)+integral
+       ENDIF
+      ENDIF
+     ENDIF
+    ENDDO
+   ENDDO
+   IF(MAXVAL(bounds)<=TRUNC_TOL)EXIT
+   deg=2*deg
+   IF(deg>MAX_DEGREE)THEN
+    ierr=3;message='WINT PAW: radial Chebyshev truncation bound exceeds degree limit';GOTO 900
+   ENDIF
+  ENDDO
+  cache_bytes=16_int64*s%ne*s%nlm*s%nlm+12_int64*s%ne+12_int64*s%nrad &
+       +8_int64*(deg+1)*s%nrad+16_int64*s%nrad
+  IF(.NOT.hold_bytes(cache_bytes))THEN
+   ierr=2;message='WINT PAW: radial cache exceeds total 512MiB workspace';GOTO 900
+  ENDIF
+  booked=cache_bytes;s%degree=deg
+  ALLOCATE(s%ell(s%ne),s%lm(s%ne),s%rad(s%ne),s%rc1(s%nrad),s%rc2(s%nrad),s%rell(s%nrad), &
+       s%cg(s%ne,s%nlm*s%nlm),s%cheb(0:deg,s%nrad),s%head(s%nrad),s%bound(s%nrad),STAT=stat)
+  IF(stat/=0)THEN
+   ierr=2;message='WINT PAW: radial cache allocation failed';GOTO 900
+  ENDIF
+  s%cg=0;lookup=0;idx=0
+  DO c1=1,nc
+   base(c1)=idx;idx=idx+2*p%LPS(c1)+1
+  ENDDO
+  e=0;rid=0
+  DO c1=1,nc
+   DO c2=c1,nc
+    DO l=ABS(p%LPS(c1)-p%LPS(c2)),p%LPS(c1)+p%LPS(c2),2
+     rid=rid+1;s%rc1(rid)=c1;s%rc2(rid)=c2;s%rell(rid)=l;s%head(rid)=0
+     IF(l==0)s%head(rid)=SUM(rho(:,rid))
+     DO m=-l,l
+      e=e+1;s%ell(e)=l;s%lm(e)=l*(l+1)+m+1;s%rad(e)=rid;lookup(c1,c2,s%lm(e))=e
+     ENDDO
+    ENDDO
+   ENDDO
+  ENDDO
+  s%bound=bounds
+  DO c1=1,nc
+   DO c2=c1,nc
+    CALL YLM3LOOKUP(p%LPS(c1),p%LPS(c2),idx)
+    DO i=1,2*p%LPS(c1)+1
+     DO j=1,2*p%LPS(c2)+1
+      idx=idx+1
+      DO ic=INDCG(idx),INDCG(idx+1)-1
+       e=lookup(c1,c2,JS(ic));IF(e<1)CYCLE
+       k=base(c1)+i+(base(c2)+j-1)*s%nlm;s%cg(e,k)=s%cg(e,k)+YLM3(ic)
+       IF(c1/=c2)THEN
+        k=base(c2)+j+(base(c1)+i-1)*s%nlm;s%cg(e,k)=s%cg(e,k)+YLM3(ic)
+       ENDIF
+      ENDDO
+     ENDDO
+    ENDDO
+   ENDDO
+  ENDDO
+  IF(deg==0)THEN
+   s%cheb(0,:)=s%head
+  ELSE
+   DO j=0,deg
+    x=COS(PI_W*REAL(j,q)/REAL(deg,q));qvalue=qmax*(x+1)/2
+    CALL radial_samples(qvalue,p,s,rho,bessel,sample(j,:))
+   ENDDO
+   DO rid=1,s%nrad
+    DO k=0,deg
+     integral=.5_q*(sample(0,rid)+(-1._q)**k*sample(deg,rid))
+     DO j=1,deg-1
+      integral=integral+sample(j,rid)*COS(PI_W*REAL(k*j,q)/REAL(deg,q))
+     ENDDO
+     s%cheb(k,rid)=integral*(2._q/REAL(deg,q))
+    ENDDO
+    s%cheb(0,rid)=s%cheb(0,rid)/2;s%cheb(deg,rid)=s%cheb(deg,rid)/2
+   ENDDO
+   s%check_error=0
+   DO j=0,deg-1
+    x=COS(PI_W*(REAL(j,q)+.5_q)/REAL(deg,q));qvalue=qmax*(x+1)/2
+    CALL radial_samples(qvalue,p,s,rho,bessel,sample(j,:))
+    DO rid=1,s%nrad
+     error=ABS(cheb_one(s%cheb(:,rid),x)-sample(j,rid));s%check_error=MAX(s%check_error,error)
+     IF(error>5.e-14_q*MAX(1._q,mass(rid)))THEN
+      ierr=3;message='WINT PAW: radial interpolation floating-point validation failed';GOTO 900
+     ENDIF
+    ENDDO
+   ENDDO
+  ENDIF
+  IF(.NOT.ALL(ieee_is_finite(s%cheb)))THEN
+   ierr=3;message='WINT PAW: nonfinite radial Chebyshev cache';GOTO 900
+  ENDIF
+900 CONTINUE
+  IF(ALLOCATED(rho))DEALLOCATE(rho)
+  IF(ALLOCATED(sample))DEALLOCATE(sample)
+  IF(ALLOCATED(bessel))DEALLOCATE(bessel)
+  IF(ALLOCATED(mass))DEALLOCATE(mass)
+  IF(ALLOCATED(bounds))DEALLOCATE(bounds)
+  IF(ALLOCATED(base))DEALLOCATE(base)
+  IF(ALLOCATED(lookup))DEALLOCATE(lookup)
+  CALL release_bytes(work_bytes)
+  IF(ierr/=0.AND.booked>0)THEN
+   ! Caller will deallocate the partially built species with its context.
+   CALL release_bytes(booked);booked=0
+  ENDIF
+ END SUBROUTINE
+ SUBROUTINE radial_samples(qvalue,p,s,rho,bessel,values)
+  REAL(q),INTENT(IN)::qvalue,rho(:,:)
+  TYPE(potcar),INTENT(IN)::p
+  TYPE(paw_species),INTENT(IN)::s
+  REAL(q),INTENT(OUT)::bessel(:,0:),values(:)
+  INTEGER::l,i,rid
+  DO l=0,s%lmax
+   IF(qvalue==0)THEN
+    bessel(:,l)=0;IF(l==0)bessel(:,l)=1
+   ELSE
+    DO i=1,p%R%NMAX
+     CALL SBESSEL(qvalue*p%R%R(i),bessel(i,l),l)
+    ENDDO
+   ENDIF
+  ENDDO
+  DO rid=1,s%nrad
+   values(rid)=0
+   DO i=1,p%R%NMAX
+    values(rid)=values(rid)+rho(i,rid)*bessel(i,s%rell(rid))
+   ENDDO
+  ENDDO
+ END SUBROUTINE
+ SUBROUTINE wint_paw_begin_accumulator(ctx,npairs,acc,ierr,message)
+  TYPE(wint_paw_context),INTENT(IN)::ctx
+  INTEGER,INTENT(IN)::npairs
+  TYPE(wint_paw_accumulator),INTENT(INOUT)::acc
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  INTEGER::nt,stat
+  INTEGER(int64)::bytes
+  ierr=0;message='';CALL wint_paw_reset_accumulator(acc)
+  IF(.NOT.ctx%ready.OR.npairs<1)THEN
+   ierr=1;message='WINT PAW: invalid accumulator context/pair count';RETURN
+  ENDIF
+  bytes=4096_int64*(SIZE(ctx%species)+1)
+  DO nt=1,SIZE(ctx%species)
+   bytes=bytes+16_int64*ctx%species(nt)%natom*ctx%species(nt)%ne*INT(npairs,int64)
+  ENDDO
+  IF(.NOT.hold_bytes(bytes))THEN
+   ierr=2;message='WINT PAW: accumulator exceeds total 512MiB workspace';RETURN
+  ENDIF
+  acc%bytes=bytes;acc%npairs=npairs;acc%generation=ctx%generation
+  ALLOCATE(acc%species(SIZE(ctx%species)),STAT=stat)
+  IF(stat==0)THEN
+   DO nt=1,SIZE(ctx%species)
+    ALLOCATE(acc%species(nt)%coef(ctx%species(nt)%natom,ctx%species(nt)%ne,npairs),STAT=stat)
+    IF(stat/=0)EXIT
+    acc%species(nt)%coef=0
+   ENDDO
+  ENDIF
+  IF(stat/=0)THEN
+   ierr=2;message='WINT PAW: accumulator allocation failed';CALL wint_paw_reset_accumulator(acc);RETURN
+  ENDIF
+  acc%ready=.true.;message='raw PAW k-sum accumulator ready'
+ END SUBROUTINE
+ SUBROUTINE wint_paw_accumulate_batch(ctx,acc,w1,w4,unfolded_d,ierr,message,weight)
+  TYPE(wint_paw_context),INTENT(IN)::ctx
+  TYPE(wint_paw_accumulator),INTENT(INOUT)::acc
+  TYPE(wavefun1),INTENT(IN)::w1(:),w4(:)
+  REAL(q),INTENT(IN)::unfolded_d(3)
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  REAL(q),OPTIONAL,INTENT(IN)::weight
+#ifndef gammareal
+  COMPLEX(q),ALLOCATABLE::p1(:,:),p4(:,:),outer(:,:),occ(:,:)
+  COMPLEX(q)::phase,value
+  REAL(q)::shift(3),w,angle
+  INTEGER::ns,bad,i,j,k,n1,n4,ntotal,nt,ni,nlm,atom,isp,base,pair,stat,e
+  INTEGER(int64)::work_bytes
+  LOGICAL::held
+#endif
+  ierr=0;message=''
+#ifdef gammareal
+  ierr=1;message='WINT PAW: gamma-real build unsupported';RETURN
+#else
+  n1=SIZE(w1);n4=SIZE(w4)
+  IF(n1<1.OR.n4<1)THEN
+   ierr=1;message='WINT PAW: empty orbital batch';RETURN
+  ENDIF
+  IF(.NOT.ASSOCIATED(w1(1)%WDES1).OR..NOT.ASSOCIATED(w4(1)%WDES1))THEN
+   ierr=1;message='WINT PAW: missing first orbital descriptor';RETURN
+  ENDIF
+  IF(.NOT.ASSOCIATED(w1(1)%WDES1%COMM_INB))THEN
+   ierr=1;message='WINT PAW: missing projector communicator';RETURN
+  ENDIF
+  bad=0;ns=w1(1)%WDES1%NRSPINORS;w=1
+  IF(PRESENT(weight))w=weight
+  IF(.NOT.ctx%ready.OR..NOT.acc%ready.OR.acc%generation/=ctx%generation)bad=1
+  IF(INT(n1,int64)*n4/=INT(acc%npairs,int64))bad=1
+  IF(acc%batches>0.AND.(acc%n1/=n1.OR.acc%n4/=n4))bad=1
+  IF(ns/=1.AND.ns/=2)bad=1
+  IF(.NOT.ieee_is_finite(w).OR..NOT.ALL(ieee_is_finite(unfolded_d)))bad=1
+  IF(ALL(ieee_is_finite(unfolded_d)))THEN
+   shift=unfolded_d-ctx%qfrac
+   IF(MAXVAL(ABS(shift-ANINT(shift)))>1.e-8_q)bad=1
+  ENDIF
+  DO k=1,n1+n4
+   IF(k<=n1)THEN
+    IF(.NOT.valid_orbital(w1(k),w1(1),ctx%stride,ns))bad=1
+   ELSE
+    IF(.NOT.valid_orbital(w4(k-n1),w1(1),ctx%stride,ns))bad=1
+   ENDIF
+  ENDDO
+  CALLMPI(M_sum_i(w1(1)%WDES1%COMM_INB,bad,1))
+  IF(bad/=0)THEN
+   ierr=1;message='WINT PAW: inconsistent batch/layout/transfer or accumulator generation';RETURN
+  ENDIF
+  ntotal=ctx%stride*ns
+  ! Include conservative full BLAS operand/output packing reservations.
+  work_bytes=16_int64*ntotal*(n1+n4)+32_int64*ctx%maxnlm**2*acc%npairs &
+       +32_int64*ctx%maxne*acc%npairs+16_int64*ctx%maxne*ctx%maxnlm**2
+  held=hold_bytes(work_bytes);bad=0;IF(.NOT.held)bad=1
+  CALLMPI(M_sum_i(w1(1)%WDES1%COMM_INB,bad,1))
+  IF(bad/=0)THEN
+   IF(held)CALL release_bytes(work_bytes)
+   ierr=2;message='WINT PAW: batch merge exceeds total 512MiB workspace';RETURN
+  ENDIF
+  ALLOCATE(p1(ntotal,n1),p4(ntotal,n4),outer(ctx%maxnlm**2,acc%npairs),occ(ctx%maxne,acc%npairs),STAT=stat)
+  bad=0;IF(stat/=0)bad=1
+  CALLMPI(M_sum_i(w1(1)%WDES1%COMM_INB,bad,1))
+  IF(bad/=0)THEN
+   ierr=2;message='WINT PAW: merge/batch allocation failed';GOTO 900
+  ENDIF
+  DO i=1,n1
+   CALL MRG_PROJ(w1(i)%WDES1,p1(:,i),w1(i)%CPROJ)
+  ENDDO
+  DO j=1,n4
+   CALL MRG_PROJ(w4(j)%WDES1,p4(:,j),w4(j)%CPROJ)
+  ENDDO
+  IF(.NOT.finite_complex(p1).OR..NOT.finite_complex(p4))THEN
+   ierr=1;message='WINT PAW: nonfinite merged projectors';GOTO 900
+  ENDIF
+  DO nt=1,SIZE(ctx%species)
+   nlm=ctx%species(nt)%nlm
+   IF(ctx%species(nt)%ne==0)CYCLE
+   DO atom=1,ctx%species(nt)%natom
+    ni=ctx%species(nt)%atoms(atom);outer=0
+    DO j=1,n4
+     DO i=1,n1
+      pair=i+n1*(j-1)
+      DO isp=0,ns-1
+       base=ctx%offset(ni)+isp*ctx%stride
+       DO k=1,nlm
+        DO e=1,nlm
+         outer(e+(k-1)*nlm,pair)=outer(e+(k-1)*nlm,pair)+p1(base+e,i)*CONJG(p4(base+k,j))
+        ENDDO
+       ENDDO
+      ENDDO
+     ENDDO
+    ENDDO
+    CALL ZGEMM('N','N',ctx%species(nt)%ne,acc%npairs,nlm*nlm,CMPLX(1._q,0._q,q), &
+         ctx%species(nt)%cg,ctx%species(nt)%ne,outer,ctx%maxnlm**2, &
+         CMPLX(0._q,0._q,q),occ,ctx%maxne)
+    angle=2*PI_W*DOT_PRODUCT(unfolded_d,ctx%pos(:,ni));phase=w*CMPLX(COS(angle),SIN(angle),q)
+    DO pair=1,acc%npairs
+     DO e=1,ctx%species(nt)%ne
+      value=acc%species(nt)%coef(atom,e,pair)+phase*occ(e,pair)
+      IF(.NOT.ieee_is_finite(REAL(value,q)).OR..NOT.ieee_is_finite(AIMAG(value)))THEN
+       ierr=3;message='WINT PAW: accumulated projector occupancy overflow';GOTO 900
+      ENDIF
+      acc%species(nt)%coef(atom,e,pair)=value
+     ENDDO
+    ENDDO
+   ENDDO
+  ENDDO
+  acc%n1=n1;acc%n4=n4;acc%batches=acc%batches+1;message='raw PAW orbital batch accumulated; no G transform'
+900 CONTINUE
+  IF(ALLOCATED(p1))DEALLOCATE(p1)
+  IF(ALLOCATED(p4))DEALLOCATE(p4)
+  IF(ALLOCATED(outer))DEALLOCATE(outer)
+  IF(ALLOCATED(occ))DEALLOCATE(occ)
+  CALL release_bytes(work_bytes)
+  IF(ierr/=0)acc%ready=.false.
+#endif
+ END SUBROUTINE
+ LOGICAL FUNCTION valid_orbital(w,reference,stride,ns)
+  TYPE(wavefun1),INTENT(IN)::w,reference
+  INTEGER,INTENT(IN)::stride,ns
+  valid_orbital=.false.
+#ifndef gammareal
+  IF(.NOT.ASSOCIATED(w%WDES1).OR..NOT.ASSOCIATED(w%CPROJ))RETURN
+  IF(.NOT.ASSOCIATED(w%WDES1%COMM_INB))RETURN
+  IF(w%WDES1%NRSPINORS/=ns.OR.w%WDES1%NPRO_TOT/=stride*ns)RETURN
+  IF(w%WDES1%LSPIRAL.OR.w%WDES1%LGAMMA)RETURN
+  IF(w%WDES1%LNONCOLLINEAR.NEQV.(ns==2))RETURN
+  IF(w%WDES1%COMM_INB%MPI_COMM/=reference%WDES1%COMM_INB%MPI_COMM)RETURN
+  IF(SIZE(w%CPROJ)<w%WDES1%NPRO)RETURN
+  valid_orbital=.true.
+#endif
+ END FUNCTION
+ LOGICAL FUNCTION finite_complex(a)
+  COMPLEX(q),INTENT(IN)::a(:,:)
+  INTEGER::i,j
+  finite_complex=.false.
+  DO j=1,SIZE(a,2)
+   DO i=1,SIZE(a,1)
+    IF(.NOT.ieee_is_finite(REAL(a(i,j),q)).OR..NOT.ieee_is_finite(AIMAG(a(i,j))))RETURN
+   ENDDO
+  ENDDO
+  finite_complex=.true.
+ END FUNCTION
+ SUBROUTINE wint_paw_add_accumulated(ctx,acc,gcharge,ierr,message)
+  TYPE(wint_paw_context),INTENT(IN)::ctx
+  TYPE(wint_paw_accumulator),INTENT(IN)::acc
+  COMPLEX(q),INTENT(INOUT)::gcharge(:,:)
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  REAL(q),ALLOCATABLE::xyz(:,:),qabs(:),x(:),ylm(:,:),radial(:,:),b1(:),b2(:),b0(:)
+  COMPLEX(q),ALLOCATABLE::phase(:,:),structure(:,:),ff(:,:),block_charge(:,:)
+  INTEGER::bs,na,ib,nb,ig,i,j,k,nt,e,rid,atom,ni,ab,an,pair,stat,pass
+  INTEGER(int64)::per_g,work_bytes,available,packing_bytes
+  REAL(q)::cart(3),frac(3),angle,density_bound,term,rad_bound,coeff_mass,gmax
+  COMPLEX(q)::factor,value,beta
+  ierr=0;message=''
+  IF(.NOT.ctx%ready.OR..NOT.acc%ready.OR.acc%generation/=ctx%generation)THEN
+   ierr=1;message='WINT PAW: invalid context/accumulator generation';RETURN
+  ENDIF
+  IF(SIZE(gcharge,1)/=ctx%ng.OR.SIZE(gcharge,2)/=acc%npairs)THEN
+   ierr=1;message='WINT PAW: accumulated output shape mismatch';RETURN
+  ENDIF
+  IF(.NOT.finite_complex(gcharge))THEN
+   ierr=1;message='WINT PAW: nonfinite incoming density';RETURN
+  ENDIF
+  IF(ctx%ng==0.OR.ctx%maxne==0)THEN
+   message='raw PAW accumulated density has no local modes';RETURN
+  ENDIF
+  ! Positive absolute coefficient bound is an overflow-range guard, not an
+  ! accuracy claim. It avoids a second expensive G transform for atomicity.
+  DO pair=1,acc%npairs
+   density_bound=0
+   DO nt=1,SIZE(ctx%species)
+    DO e=1,ctx%species(nt)%ne
+     rid=ctx%species(nt)%rad(e)
+     rad_bound=MAX(SUM(ABS(ctx%species(nt)%cheb(:,rid))),ABS(ctx%species(nt)%head(rid)))
+     coeff_mass=0
+     DO atom=1,ctx%species(nt)%natom
+      coeff_mass=coeff_mass+ABS(acc%species(nt)%coef(atom,e,pair))
+     ENDDO
+     term=ctx%nfft*4*PI_W*SQRT(REAL(2*ctx%species(nt)%ell(e)+1,q)/(4*PI_W))*rad_bound*coeff_mass
+     IF(.NOT.ieee_is_finite(term).OR.term>HUGE(1._q)/64)THEN
+      ierr=3;message='WINT PAW: density magnitude cannot be bounded safely';RETURN
+     ENDIF
+     IF(density_bound>HUGE(1._q)/64-term)THEN
+      ierr=3;message='WINT PAW: density magnitude cannot be bounded safely';RETURN
+     ENDIF
+     density_bound=density_bound+term
+    ENDDO
+   ENDDO
+   gmax=0
+   DO i=1,ctx%ng
+    gmax=MAX(gmax,ABS(REAL(gcharge(i,pair),q)),ABS(AIMAG(gcharge(i,pair))))
+   ENDDO
+   IF(gmax>HUGE(1._q)-8*density_bound)THEN
+    ierr=3;message='WINT PAW: incoming plus accumulated density can overflow';RETURN
+   ENDIF
+  ENDDO
+  na=MIN(MAX_ATOMBLOCK,MAX(1,ctx%maxatom))
+  per_g=8_int64*(3+1+1+(ctx%lmax+1)**2+ctx%maxrad+3) &
+       +16_int64*(2*na+2*ctx%maxne*acc%npairs+ctx%maxne+acc%npairs)
+  packing_bytes=16_int64*na*ctx%maxne*acc%npairs
+  available=MEMORY_LIMIT-PLAN_RESERVE-resident-packing_bytes
+  bs=INT(MIN(INT(MAX_GBLOCK,int64),available/MAX(1_int64,per_g)))
+  bs=MIN(bs,ctx%ng)
+  IF(bs<1)THEN
+   ierr=2;message='WINT PAW: no G block fits total 512MiB workspace';RETURN
+  ENDIF
+  work_bytes=per_g*bs+packing_bytes
+  IF(.NOT.hold_bytes(work_bytes))THEN
+   ierr=2;message='WINT PAW: G block exceeds total 512MiB workspace';RETURN
+  ENDIF
+  ALLOCATE(xyz(bs,3),qabs(bs),x(bs),ylm(bs,(ctx%lmax+1)**2),radial(bs,ctx%maxrad), &
+       b1(bs),b2(bs),b0(bs),phase(bs,na),structure(bs,ctx%maxne*acc%npairs), &
+       ff(bs,ctx%maxne),block_charge(bs,acc%npairs),STAT=stat)
+  IF(stat/=0)THEN
+   ierr=2;message='WINT PAW: G block allocation failed';GOTO 900
+  ENDIF
+   DO ib=1,ctx%ng,bs
+    nb=MIN(bs,ctx%ng-ib+1)
+    DO i=1,nb
+     ig=ib+i-1;frac=REAL(ctx%gvec(:,ig),q)+ctx%qfrac;cart=2*PI_W*MATMUL(ctx%b,frac)
+     qabs(i)=SQRT(SUM(cart*cart))
+     IF(qabs(i)>0)THEN
+      xyz(i,:)=cart/qabs(i)
+     ELSE
+      xyz(i,:)=[0._q,0._q,1._q]
+     ENDIF
+     x(i)=0
+     IF(ctx%qmax>0)x(i)=MAX(-1._q,MIN(1._q,2*qabs(i)/ctx%qmax-1))
+    ENDDO
+    CALL SETYLM(ctx%lmax,nb,ylm,xyz(:,1),xyz(:,2),xyz(:,3))
+    block_charge=0
+    DO nt=1,SIZE(ctx%species)
+     ASSOCIATE(s=>ctx%species(nt))
+     IF(s%ne==0.OR.s%natom==0)CYCLE
+     DO rid=1,s%nrad
+      b1=0;b2=0
+      DO k=s%degree,1,-1
+       DO i=1,nb
+        b0(i)=2*x(i)*b1(i)-b2(i)+s%cheb(k,rid)
+       ENDDO
+       b2(:nb)=b1(:nb);b1(:nb)=b0(:nb)
+      ENDDO
+      DO i=1,nb
+       radial(i,rid)=x(i)*b1(i)-b2(i)+s%cheb(0,rid)
+       IF(qabs(i)==0)radial(i,rid)=s%head(rid)
+      ENDDO
+     ENDDO
+     DO e=1,s%ne
+      factor=(ctx%nfft*4*PI_W)*CMPLX(0._q,-1._q,q)**s%ell(e)
+      DO i=1,nb
+       ff(i,e)=factor*ylm(i,s%lm(e))*radial(i,s%rad(e))
+      ENDDO
+     ENDDO
+     DO ab=1,s%natom,na
+      an=MIN(na,s%natom-ab+1)
+      DO atom=1,an
+       ni=s%atoms(ab+atom-1)
+       DO i=1,nb
+        angle=-2*PI_W*DOT_PRODUCT(REAL(ctx%gvec(:,ib+i-1),q)+ctx%qfrac,ctx%pos(:,ni))
+        phase(i,atom)=CMPLX(COS(angle),SIN(angle),q)
+       ENDDO
+      ENDDO
+      beta=CMPLX(1._q,0._q,q)
+      IF(ab==1)beta=CMPLX(0._q,0._q,q)
+      CALL ZGEMM('N','N',nb,s%ne*acc%npairs,an,CMPLX(1._q,0._q,q),phase,bs, &
+           acc%species(nt)%coef(ab,1,1),s%natom,beta,structure,bs)
+     ENDDO
+     DO pair=1,acc%npairs
+      DO e=1,s%ne
+       j=e+s%ne*(pair-1)
+       DO i=1,nb
+        block_charge(i,pair)=block_charge(i,pair)+ff(i,e)*structure(i,j)
+       ENDDO
+      ENDDO
+     ENDDO
+     END ASSOCIATE
+    ENDDO
+    DO pair=1,acc%npairs
+     DO i=1,nb
+      value=gcharge(ib+i-1,pair)+block_charge(i,pair)
+      IF(.NOT.ieee_is_finite(REAL(value,q)).OR..NOT.ieee_is_finite(AIMAG(value)))THEN
+       ierr=3;message='WINT PAW: accumulated density overflow';GOTO 900
+      ENDIF
+      gcharge(ib+i-1,pair)=value
+     ENDDO
+    ENDDO
+   ENDDO
+  message='raw PAW k-summed density added with bounded G/atom blocks'
+900 CONTINUE
+  IF(ALLOCATED(xyz))DEALLOCATE(xyz)
+  IF(ALLOCATED(qabs))DEALLOCATE(qabs)
+  IF(ALLOCATED(x))DEALLOCATE(x)
+  IF(ALLOCATED(ylm))DEALLOCATE(ylm)
+  IF(ALLOCATED(radial))DEALLOCATE(radial)
+  IF(ALLOCATED(b1))DEALLOCATE(b1)
+  IF(ALLOCATED(b2))DEALLOCATE(b2)
+  IF(ALLOCATED(b0))DEALLOCATE(b0)
+  IF(ALLOCATED(phase))DEALLOCATE(phase)
+  IF(ALLOCATED(structure))DEALLOCATE(structure)
+  IF(ALLOCATED(ff))DEALLOCATE(ff)
+  IF(ALLOCATED(block_charge))DEALLOCATE(block_charge)
+  CALL release_bytes(work_bytes)
+ END SUBROUTINE
+ SUBROUTINE wint_paw_add_density(ctx,w1,w4,unfolded_d,gcharge,ierr,message)
+  TYPE(wint_paw_context),INTENT(IN)::ctx
+  TYPE(wavefun1),INTENT(IN)::w1,w4
+  REAL(q),INTENT(IN)::unfolded_d(3)
+  COMPLEX(q),TARGET,CONTIGUOUS,INTENT(INOUT)::gcharge(:)
+  INTEGER,INTENT(OUT)::ierr
+  CHARACTER(*),INTENT(OUT)::message
+  TYPE(wint_paw_accumulator)::acc
+  COMPLEX(q),POINTER::matrix(:,:)
+  matrix(1:SIZE(gcharge),1:1)=>gcharge
+  CALL wint_paw_begin_accumulator(ctx,1,acc,ierr,message)
+  IF(ierr==0)CALL wint_paw_accumulate_batch(ctx,acc,[w1],[w4],unfolded_d,ierr,message)
+  IF(ierr==0)CALL wint_paw_add_accumulated(ctx,acc,matrix,ierr,message)
+  CALL wint_paw_reset_accumulator(acc)
+ END SUBROUTINE
+END MODULE
diff --git a/src/wint_layered.F b/src/wint_layered.F
new file mode 100644
--- /dev/null
+++ b/src/wint_layered.F
@@ -0,0 +1,940 @@
+! Physical layered interactions on fixed Fourier pair densities.
+MODULE wint_layered
+  USE iso_fortran_env, ONLY: real64,int64,int32
+  USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
+  IMPLICIT NONE
+  PRIVATE
+  INTEGER, PARAMETER :: dp=real64
+  REAL(dp), PARAMETER :: pi=3.141592653589793238462643383279502884_dp
+  REAL(dp), PARAMETER :: sqrtpi=1.77245385090551602729816748334114518_dp
+  REAL(dp), PARAMETER :: tailcut=8.5_dp
+  INTEGER(int64), PARAMETER :: memory_limit=536870912_int64
+  INTEGER, PARAMETER :: panel_order=24
+  PUBLIC :: wlayer_init,wlayer_apply,wlayer_block,wlayer_normal,wlayer_info,wlayer_reset
+  LOGICAL, SAVE :: ready=.false.
+  INTEGER, SAVE :: model_s=0,mesh_s(3)=0,grid_s(2)=0,override_s(2)=0,mmax_s=-1
+  REAL(dp), SAVE :: a_s(3,3)=0,normal_s(3)=0,b_s(3,2)=0,zsign_s=1
+  REAL(dp), SAVE :: kappa_s=0,eps_s=1,r0_s=0,d_s=0,ohno_s=0,z0_s=0,tol_s=1e-8_dp
+  REAL(dp), SAVE :: rin_s=0,alpha_s=0,lz_s=0,area_s=0,qmax_s=-1,quaderr_s=0
+  INTEGER(int64), SAVE :: bytes_s=0,peak_s=0,reserve_input_s=0
+  REAL(dp), ALLOCATABLE, SAVE :: tl(:),wl(:),xh(:),wh(:),plane(:,:,:)
+  REAL(dp), ALLOCATABLE, SAVE :: mt(:,:,:)
+CONTAINS
+  SUBROUTINE wlayer_reset()
+    IF (ALLOCATED(tl)) DEALLOCATE(tl,wl)
+    IF (ALLOCATED(xh)) DEALLOCATE(xh,wh)
+    IF (ALLOCATED(plane)) DEALLOCATE(plane)
+    IF (ALLOCATED(mt)) DEALLOCATE(mt)
+    ready=.false.;mmax_s=-1;qmax_s=-1;bytes_s=0;peak_s=0;reserve_input_s=0;quaderr_s=0
+  END SUBROUTINE
+
+  SUBROUTINE wlayer_info(ngrid,rin,alpha,lz,bytes,ntlow,nthigh,maxmode,quad_error)
+    INTEGER, INTENT(OUT) :: ngrid(2),ntlow,nthigh,maxmode
+    REAL(dp), INTENT(OUT) :: rin,alpha,lz,quad_error
+    INTEGER(int64), INTENT(OUT) :: bytes
+    ngrid=grid_s;rin=rin_s;alpha=alpha_s;lz=lz_s;bytes=peak_s
+    ntlow=0;nthigh=0
+    IF (ALLOCATED(tl)) ntlow=SIZE(tl)
+    IF (ALLOCATED(xh)) nthigh=SIZE(xh)
+    maxmode=mmax_s;quad_error=quaderr_s
+  END SUBROUTINE
+
+  SUBROUTINE wlayer_init(aprim,mesh,model,kappa,epsilon_r,r0,gate_d,z0,normal,tol,ngrid,ierr,message,ohno_a)
+    REAL(dp), INTENT(IN) :: aprim(3,3),kappa,epsilon_r,r0,gate_d,z0,normal(3),tol
+    REAL(dp), OPTIONAL, INTENT(IN) :: ohno_a
+    INTEGER, INTENT(IN) :: mesh(3),model,ngrid(3)
+    INTEGER, INTENT(OUT) :: ierr
+    CHARACTER(*), INTENT(OUT) :: message
+    REAL(dp) :: n(3),c(3),a1(3),a2(3),br1(3),br2(3),vec(3),rr,nn,det,first,bandwidth,ab1(3),ab2(3)
+    REAL(dp) :: soft_length
+    REAL(dp), ALLOCATABLE :: dist(:,:)
+    COMPLEX(dp), ALLOCATABLE :: work(:,:)
+    INTEGER :: ng(2),i,j,k,stat
+    INTEGER(int64) :: need
+    ierr=0;message=''
+    soft_length=0
+    IF (PRESENT(ohno_a)) soft_length=ohno_a
+    IF (.NOT.ALL(ieee_is_finite(aprim)).OR..NOT.ALL(ieee_is_finite(normal)).OR. &
+        .NOT.ALL(ieee_is_finite([kappa,epsilon_r,r0,gate_d,soft_length,z0,tol]))) THEN
+      ierr=1;message='Layered kernel parameters and lattice must be finite';RETURN
+    ENDIF
+    IF (model<0.OR.model>5.OR.ANY(mesh<1).OR.mesh(3)/=1.OR.kappa<0.OR.r0<0.OR.epsilon_r<=0.OR. &
+        tol<=0.OR.tol>1e-2_dp) THEN
+      ierr=1;message='Invalid layered model, mesh, screening, permittivity or tolerance';RETURN
+    ENDIF
+    IF (soft_length<0.OR.(model/=5.AND.soft_length/=0)) THEN
+      ierr=1;message='A nonnegative Ohno length is supported only for DUAL_GATE_RADIAL';RETURN
+    ENDIF
+    IF (model==5.AND.gate_d<=0) THEN
+      ierr=1;message='DUAL_GATE_RADIAL requires positive midpoint-to-gate distance';RETURN
+    ENDIF
+    c=aprim(:,3);nn=NORM2(c)
+    IF (nn<=0) THEN
+      ierr=1;message='Layered kernel requires a nonzero normal lattice vector';RETURN
+    ENDIF
+    n=c/nn
+    IF (SUM(normal*normal)>0) THEN
+      vec=normal/MAXVAL(ABS(normal));vec=vec/SQRT(SUM(vec*vec))
+      IF (ABS(ABS(DOT_PRODUCT(vec,n))-1)>1e-10_dp) THEN
+        ierr=1;message='WINT_NORMAL must be parallel to the third lattice vector';RETURN
+      ENDIF
+      n=vec
+    ENDIF
+    IF (MAXVAL(ABS(MATMUL(TRANSPOSE(aprim(:,1:2)),n)))> &
+        1e-10_dp*MAXVAL(ABS(aprim))) THEN
+      ierr=1;message='SLAB_WS requires the third lattice vector perpendicular to the in-plane lattice';RETURN
+    ENDIF
+    IF (model==4.AND.gate_d<=0.5_dp*nn) THEN
+      ierr=1;message='Both gate planes must enclose the entire centered normal integration cell';RETURN
+    ENDIF
+    ng=ngrid(1:2)
+    WHERE(ng==0) ng=16
+    IF (ANY(ng<16).OR.ANY(IAND(ng,ng-1)/=0)) THEN
+      ierr=1;message='Layered WS plane grids must be powers of two, at least 16';RETURN
+    ENDIF
+    IF (ANY(INT(ng,int64)>memory_limit/(8_int64*24_int64*16_int64))) THEN
+      ierr=2;message='Layered plane dimensions exceed minimum workspace';RETURN
+    ENDIF
+    IF (ready) THEN
+      IF (ALL(a_s==aprim).AND.ALL(mesh_s==mesh).AND.model_s==model.AND.kappa_s==kappa.AND. &
+          eps_s==epsilon_r.AND.r0_s==r0.AND.d_s==gate_d.AND.ohno_s==soft_length.AND. &
+          z0_s==z0.AND.tol_s==tol.AND. &
+          ALL(override_s==ngrid(1:2)).AND.ALL(normal_s==n)) RETURN
+    ENDIF
+    CALL wlayer_reset()
+    a_s=aprim;mesh_s=mesh;model_s=model;kappa_s=kappa;eps_s=epsilon_r;r0_s=r0;d_s=gate_d
+    ohno_s=soft_length;z0_s=z0;tol_s=tol;grid_s=ng;override_s=ngrid(1:2);normal_s=n;lz_s=nn
+    zsign_s=SIGN(1._dp,DOT_PRODUCT(n,c))
+    a1=aprim(:,1)*REAL(mesh(1),dp);a2=aprim(:,2)*REAL(mesh(2),dp)
+    area_s=SQRT(SUM(cross(a1,a2)**2))
+    det=DOT_PRODUCT(aprim(:,1),cross(aprim(:,2),n))
+    IF (ABS(det)<=TINY(1._dp).OR.area_s<=0) THEN
+      ierr=1;message='Singular layered plane lattice';RETURN
+    ENDIF
+    b_s(:,1)=cross(aprim(:,2),n)/det
+    b_s(:,2)=cross(n,aprim(:,1))/det
+    br1=a1;br2=a2
+    CALL reduce2(br1,br2,ierr)
+    IF (ierr/=0) THEN
+      message='Could not reduce layered plane lattice';RETURN
+    ENDIF
+    rin_s=0.5_dp*SQRT(shortest2(br1,br2))*(1-64*EPSILON(1._dp))
+    alpha_s=SQRT(-LOG(MAX(TINY(1._dp),MIN(1e-13_dp,tol*1e-3_dp))))/MIN(rin_s,lz_s/2)
+    IF (.NOT.ieee_is_finite(alpha_s)) THEN
+      ierr=1;message='Layered geometry is outside floating point range';RETURN
+    ENDIF
+    bandwidth=2*alpha_s*SQRT(-LOG(tol_s))
+    DO i=1,2
+      vec=aprim(:,i)*REAL(mesh(i),dp)
+      DO WHILE(REAL(ng(i),dp)<=bandwidth*SQRT(SUM(vec*vec))/pi)
+        IF (ngrid(i)/=0) THEN
+          ierr=1;message='Layered WS plane grid does not contain the Gaussian bandwidth';RETURN
+        ENDIF
+        IF (ng(i)>1048576) THEN
+          ierr=2;message='Layered automatic plane grid exceeds workspace';RETURN
+        ENDIF
+        ng(i)=ng(i)*2
+      ENDDO
+    ENDDO
+    DO
+      ab1=2*pi*b_s(:,1)/REAL(mesh_s(1),dp)*REAL(ng(1),dp)
+      ab2=2*pi*b_s(:,2)/REAL(mesh_s(2),dp)*REAL(ng(2),dp)
+      CALL reduce2(ab1,ab2,ierr)
+      IF (ierr/=0) THEN
+        message='Could not certify layered reciprocal alias lattice';RETURN
+      ENDIF
+      IF (SQRT(shortest2(ab1,ab2))*(1-64*EPSILON(1._dp))/2>bandwidth) EXIT
+      IF (ALL(ngrid(1:2)/=0)) THEN
+        ierr=1;message='Layered WS grid fails the Cartesian Gaussian alias bound';RETURN
+      ENDIF
+      WHERE(ngrid(1:2)==0) ng=ng*2
+      IF (8_int64*INT(ng(1),int64)*INT(ng(2),int64)*24_int64>memory_limit) THEN
+        ierr=2;message='Layered automatic alias-safe grid exceeds workspace';RETURN
+      ENDIF
+    ENDDO
+    grid_s=ng
+    first=MIN(alpha_s,1/lz_s)
+    IF (r0_s>1/first) first=1/r0_s
+    IF (model_s==4) first=MIN(first,1/d_s)
+    IF (model_s==5.AND.MAX(d_s,ohno_s)>1/first) first=1/MAX(d_s,ohno_s)
+    CALL panels(first,alpha_s,tl,wl,ierr)
+    IF (ierr/=0) THEN
+      message='Layered low-t quadrature exceeds supported workspace';RETURN
+    ENDIF
+    need=8_int64*INT(ng(1),int64)*INT(ng(2),int64)*INT(SIZE(tl),int64)+ &
+         24_int64*INT(ng(1),int64)*INT(ng(2),int64)+ &
+         16_int64*INT(SIZE(tl),int64)+16777216_int64
+    IF (need>memory_limit) THEN
+      ierr=2;message='Layered plane construction exceeds 512 MiB additional workspace';CALL wlayer_reset();RETURN
+    ENDIF
+    peak_s=MAX(peak_s,need)
+    ALLOCATE(plane(ng(1),ng(2),SIZE(tl)),dist(ng(1),ng(2)),work(ng(1),ng(2)),STAT=stat)
+    IF (stat/=0) THEN
+      ierr=2;message='Layered plane allocation failed';CALL wlayer_reset();RETURN
+    ENDIF
+    DO j=1,ng(2)
+      DO i=1,ng(1)
+        vec=REAL(i-1,dp)/ng(1)*a1+REAL(j-1,dp)/ng(2)*a2
+        dist(i,j)=nearest2(vec,br1,br2)
+      ENDDO
+    ENDDO
+    DO k=1,SIZE(tl)
+      work=CMPLX(EXP(-tl(k)**2*dist),0._dp,dp)
+      DO j=1,ng(2)
+        CALL fft1(work(:,j))
+      ENDDO
+      DO i=1,ng(1)
+        CALL fft1(work(i,:))
+      ENDDO
+      plane(:,:,k)=REAL(work,dp)*(area_s/REAL(INT(ng(1),int64)*INT(ng(2),int64),dp))
+    ENDDO
+    bytes_s=8_int64*SIZE(plane,kind=int64)+16_int64*SIZE(tl,kind=int64)+16777216_int64
+    ready=.true.
+  END SUBROUTINE
+
+  SUBROUTINE panels(first,last,x,w,ierr)
+    REAL(dp), INTENT(IN) :: first,last
+    REAL(dp), ALLOCATABLE, INTENT(OUT) :: x(:),w(:)
+    INTEGER, INTENT(OUT) :: ierr
+    REAL(dp) :: edges(2049),a,b,xx(panel_order),ww(panel_order)
+    INTEGER :: n,k,p
+    ierr=0
+    IF (first<=0.OR.last<=0.OR..NOT.ieee_is_finite(first).OR..NOT.ieee_is_finite(last)) THEN
+      ierr=2;RETURN
+    ENDIF
+    edges(1)=0;edges(2)=MIN(first,last);n=2
+    DO WHILE(edges(n)<last)
+      IF (n>=2049) THEN
+        ierr=2;RETURN
+      ENDIF
+      b=MIN(last,edges(n)*2)
+      IF (b<=edges(n)) THEN
+        ierr=2;RETURN
+      ENDIF
+      n=n+1;edges(n)=b
+    ENDDO
+    ALLOCATE(x((n-1)*panel_order),w((n-1)*panel_order))
+    CALL legendre(panel_order,xx,ww)
+    DO k=1,n-1
+      a=edges(k);b=edges(k+1);p=(k-1)*panel_order
+      x(p+1:p+panel_order)=0.5_dp*((b-a)*xx+(b+a))
+      w(p+1:p+panel_order)=0.5_dp*(b-a)*ww
+    ENDDO
+  END SUBROUTINE
+
+  SUBROUTINE ensure_modes(mmax,qmax,ierr,message)
+    INTEGER, INTENT(IN) :: mmax
+    REAL(dp), INTENT(IN) :: qmax
+    INTEGER, INTENT(OUT) :: ierr
+    CHARACTER(*), INTENT(OUT) :: message
+    REAL(dp) :: first,last,scale
+    INTEGER :: i,j,k,n,stat
+    INTEGER(int64) :: need
+    ierr=0;message=''
+    IF (.NOT.ready) THEN
+      ierr=1;message='Layered context is not initialized';RETURN
+    ENDIF
+    IF (mmax<0.OR.mmax>4096.OR.qmax<0.OR..NOT.ieee_is_finite(qmax)) THEN
+      ierr=2;message='Layered Fourier extent is unsupported';RETURN
+    ENDIF
+    IF (mmax_s==mmax.AND.qmax<=qmax_s.AND.ALLOCATED(mt)) RETURN
+    IF (ALLOCATED(mt)) DEALLOCATE(mt)
+    IF (ALLOCATED(xh)) DEALLOCATE(xh,wh)
+    mmax_s=-1;qmax_s=-1
+    bytes_s=8_int64*SIZE(plane,kind=int64)+16_int64*SIZE(tl,kind=int64)+16777216_int64
+    scale=MAX(alpha_s,qmax,kappa_s,2*pi*REAL(mmax,dp)/lz_s,1/lz_s)
+    first=1/scale;last=1/alpha_s
+    IF (r0_s>0) first=MIN(first,r0_s)
+    IF (model_s==4) first=MIN(first,2*d_s-lz_s)
+    IF (model_s==5) THEN
+      first=MIN(first,d_s)
+      IF (ohno_s>0) first=MIN(first,ohno_s)
+    ENDIF
+    CALL panels(first,last,xh,wh,ierr)
+    IF (ierr/=0) THEN
+      message='Layered high-t quadrature is outside supported range';RETURN
+    ENDIF
+    IF (ANY(xh<1/HUGE(1._dp))) THEN
+      ierr=2;message='Layered quadrature is outside representable reciprocal range';RETURN
+    ENDIF
+    n=2*mmax+1
+    need=bytes_s+reserve_input_s+16_int64*SIZE(xh,kind=int64)+ &
+         8_int64*INT(n,int64)*INT(n,int64)*INT(SIZE(tl)+SIZE(xh),int64)+ &
+         64_int64*INT(n,int64)*INT(n,int64)+1048576_int64
+    IF (need>memory_limit) THEN
+      ierr=2;message='Layered normal projection exceeds 512 MiB additional workspace';RETURN
+    ENDIF
+    peak_s=MAX(peak_s,need)
+    ALLOCATE(mt(-mmax:mmax,-mmax:mmax,SIZE(tl)+SIZE(xh)),STAT=stat)
+    IF (stat/=0) THEN
+      ierr=2;message='Layered normal projection allocation failed';RETURN
+    ENDIF
+    DO k=1,SIZE(tl)
+      CALL wlayer_normal(tl(k),mmax,mt(:,:,k),ierr,message)
+      IF (ierr/=0) RETURN
+      mt(:,:,k)=mt(:,:,k)*(2/sqrtpi)*wl(k)/eps_s
+    ENDDO
+    DO k=1,SIZE(xh)
+      CALL wlayer_normal(1/xh(k),mmax,mt(:,:,SIZE(tl)+k),ierr,message)
+      IF (ierr/=0) RETURN
+      ! dt=dx/x² cancels the x² in the analytic plane Gaussian.
+      mt(:,:,SIZE(tl)+k)=mt(:,:,SIZE(tl)+k)*(2*sqrtpi)*wh(k)/eps_s
+    ENDDO
+    bytes_s=8_int64*SIZE(plane,kind=int64)+16_int64*(SIZE(tl,kind=int64)+SIZE(xh,kind=int64))+ &
+         8_int64*SIZE(mt,kind=int64)+16777216_int64
+    mmax_s=mmax;qmax_s=qmax
+  END SUBROUTINE
+
+  SUBROUTINE wlayer_normal(t,mmax,matrix,ierr,message)
+    REAL(dp), INTENT(IN) :: t
+    INTEGER, INTENT(IN) :: mmax
+    REAL(dp), INTENT(OUT) :: matrix(-mmax:mmax,-mmax:mmax)
+    INTEGER, INTENT(OUT) :: ierr
+    CHARACTER(*), INTENT(OUT) :: message
+    REAL(dp) :: s(-mmax:mmax),c(-mmax:mmax),ss(-mmax:mmax),cc(-mmax:mmax)
+    REAL(dp), ALLOCATABLE :: f0(:,:),fr(:,:)
+    REAL(dp) :: v(-mmax:mmax),eta,td,dg,coef,arg,kphase,aa,weight,ratio
+    INTEGER :: i,j,n,nn,lim
+    ierr=0;message='';matrix=0
+    IF (.NOT.ready.OR.t<=0.OR..NOT.ieee_is_finite(t).OR.mmax<0) THEN
+      ierr=1;message='Invalid normal projection query';RETURN
+    ENDIF
+    IF (model_s==5) THEN
+      weight=radial_gate_weight(t,d_s,ohno_s)
+      IF (weight==0) RETURN
+    ENDIF
+    eta=t*lz_s
+    IF (.NOT.ieee_is_finite(eta)) THEN
+      ierr=1;message='Normal projection scale overflow';RETURN
+    ENDIF
+    IF (model_s==3) THEN
+      matrix(0,0)=lz_s*sheet_ratio(0._dp,r0_s,t)
+      RETURN
+    ENDIF
+    IF (model_s==4) THEN
+      td=t*d_s;dg=d_s/lz_s
+      IF (td<0.8_dp) THEN
+        lim=CEILING(4*td*tailcut/pi)
+        DO n=1,lim
+          weight=EXP(-(REAL(n,dp)*pi/(4*td))**2)*sqrtpi/td*lz_s
+          aa=REAL(n,dp)*pi/(2*dg)
+          DO i=-mmax,mmax
+            kphase=2*pi*REAL(i,dp)
+            IF (MOD(n,2)==1) THEN
+              v(i)=REAL(parity((n-1)/2),dp)*0.5_dp*(sinc((aa-kphase)/2)+sinc((aa+kphase)/2))
+            ELSE
+              v(i)=-REAL(parity(n/2),dp)*0.5_dp*(sinc((aa-kphase)/2)-sinc((aa+kphase)/2))
+            ENDIF
+          ENDDO
+          DO j=-mmax,mmax
+            matrix(:,j)=matrix(:,j)+weight*v*v(j)
+          ENDDO
+        ENDDO
+        RETURN
+      ENDIF
+      CALL gaussian_moments(eta,0._dp,mmax,s,c,ierr)
+      IF (ierr/=0) GOTO 90
+      ! Remaining images can be omitted once farther than tailcut Gaussian widths.
+      IF (dg<0.5_dp*(1+tailcut/eta)) THEN
+        IF (16_int64*INT(2*mmax+1,int64)**2+bytes_s>memory_limit) THEN
+          ierr=2;message='Gate normal matrices exceed the additional workspace budget';RETURN
+        ENDIF
+        ALLOCATE(f0(-mmax:mmax,-mmax:mmax),fr(-mmax:mmax,-mmax:mmax))
+        lim=CEILING((1+tailcut/eta)/(4*dg))+1
+        DO n=1,lim
+          CALL gaussian_moments(eta,4*REAL(n,dp)*dg,mmax,ss,cc,ierr)
+          s=s+ss;c=c+cc
+          CALL gaussian_moments(eta,-4*REAL(n,dp)*dg,mmax,ss,cc,ierr)
+          s=s+ss;c=c+cc
+        ENDDO
+        CALL difference_matrix(s,c,mmax,f0)
+        s=0;c=0
+        DO n=0,lim
+          CALL gaussian_moments(eta,(4*REAL(n,dp)+2)*dg,mmax,ss,cc,ierr)
+          s=s+ss;c=c+cc
+          CALL gaussian_moments(eta,-(4*REAL(n,dp)+2)*dg,mmax,ss,cc,ierr)
+          s=s+ss;c=c+cc
+        ENDDO
+        CALL difference_matrix(s,c,mmax,fr)
+        DO j=-mmax,mmax
+          matrix(:,j)=f0(:,j)-fr(:,-j)
+        ENDDO
+      ELSE
+        CALL difference_matrix(s,c,mmax,matrix)
+      ENDIF
+      RETURN
+    ENDIF
+    CALL gaussian_moments(eta,0._dp,mmax,s,c,ierr)
+    IF (ierr/=0) GOTO 90
+    CALL difference_matrix(s,c,mmax,matrix)
+    IF (model_s==5) THEN
+      matrix=matrix*weight
+      RETURN
+    ENDIF
+    IF (model_s==2.AND.r0_s>0) THEN
+      CALL sheet_moments(t,mmax,s,c,ss,cc,ierr)
+      IF (ierr/=0) GOTO 90
+      DO j=-mmax,mmax
+        DO i=-mmax,mmax
+          coef=REAL(parity(i+j),dp)
+          IF (ABS(i)/=ABS(j)) THEN
+            matrix(i,j)=matrix(i,j)+4*lz_s*( &
+               REAL(i,dp)*(s(i)+coef*ss(i))-REAL(j,dp)*(s(j)+coef*ss(j)))/ &
+               (2*pi*REAL(i*i-j*j,dp))
+          ELSE IF (i/=0) THEN
+            matrix(i,j)=matrix(i,j)+2*lz_s*((s(i)+coef*ss(i))/(2*pi*REAL(i,dp))+c(i)+coef*cc(i))
+          ELSE
+            matrix(i,j)=matrix(i,j)+4*lz_s*(c(i)+cc(i))
+          ENDIF
+        ENDDO
+      ENDDO
+    ENDIF
+    IF (model_s==1.AND.kappa_s>0) THEN
+      IF (t<kappa_s/(2*tailcut)) THEN
+        matrix=0
+      ELSE
+        ratio=(kappa_s/t)/2
+        matrix=matrix*EXP(-ratio*ratio)
+      ENDIF
+    ENDIF
+    RETURN
+90  message='Normal Galerkin quadrature did not converge'
+  END SUBROUTINE
+
+  ! Gaussian representation of the midpoint image sum evaluated at the
+  ! three-dimensional separation: theta_4(0,exp[-(2*d*t)^2])*exp[-(a*t)^2].
+  ! The Poisson-transformed odd modes avoid alternating cancellation at small d*t.
+  PURE REAL(dp) FUNCTION radial_gate_weight(t,d,a) RESULT(w)
+    REAL(dp), INTENT(IN) :: t,d,a
+    REAL(dp) :: td,ta,arg
+    INTEGER :: n
+    IF (t>=1) THEN
+      td=t*MIN(d,tailcut/t)
+      ta=t*MIN(a,tailcut/t)
+    ELSE
+      td=MIN(t*d,tailcut)
+      ta=MIN(t*a,tailcut)
+    ENDIF
+    w=0
+    IF (ta>=tailcut.OR.td<=pi/(4*tailcut)) RETURN
+    IF (td<0.8_dp) THEN
+      DO n=0,CEILING(2*td*tailcut/pi)
+        arg=(2*n+1)*pi/(4*td)
+        w=w+EXP(-arg*arg)
+      ENDDO
+      w=w*sqrtpi/td
+    ELSE
+      w=1
+      DO n=1,CEILING(tailcut/(2*td))
+        arg=2*n*td
+        w=w+2*(-1)**n*EXP(-arg*arg)
+      ENDDO
+    ENDIF
+    w=w*EXP(-ta*ta)
+  END FUNCTION
+
+  SUBROUTINE difference_matrix(s,c,mmax,mat)
+    INTEGER, INTENT(IN) :: mmax
+    REAL(dp), INTENT(IN) :: s(-mmax:mmax),c(-mmax:mmax)
+    REAL(dp), INTENT(OUT) :: mat(-mmax:mmax,-mmax:mmax)
+    INTEGER :: i,j
+    DO j=-mmax,mmax
+      DO i=-mmax,mmax
+        IF (i==j) THEN
+          mat(i,j)=2*lz_s*c(i)
+        ELSE
+          mat(i,j)=2*lz_s*REAL(parity(j-i+1),dp)*(s(j)-s(i))/(2*pi*REAL(j-i,dp))
+        ENDIF
+      ENDDO
+    ENDDO
+  END SUBROUTINE
+
+  SUBROUTINE gaussian_moments(eta,shift,mmax,s,c,ierr)
+    REAL(dp), INTENT(IN) :: eta,shift
+    INTEGER, INTENT(IN) :: mmax
+    REAL(dp), INTENT(OUT) :: s(-mmax:mmax),c(-mmax:mmax)
+    INTEGER, INTENT(OUT) :: ierr
+    REAL(dp) :: lo,hi,err,ss(-mmax:mmax),cc(-mmax:mmax),threshold
+    INTEGER :: n
+    ierr=0;s=0;c=0
+    lo=MAX(0._dp,-shift-tailcut/eta);hi=MIN(1._dp,-shift+tailcut/eta)
+    IF (hi<=lo) RETURN
+    n=MAX(24,CEILING(2*REAL(mmax,dp)*(hi-lo))+16)
+    CALL gaussian_once(n,lo,hi,eta,shift,mmax,s,c)
+    threshold=MAX(3e-14_dp,tol_s*1e-4_dp)
+    DO
+      n=n*2
+      IF (n>2048) THEN
+        ierr=3;RETURN
+      ENDIF
+      CALL gaussian_once(n,lo,hi,eta,shift,mmax,ss,cc)
+      err=MAX(MAXVAL(ABS(ss-s)),MAXVAL(ABS(cc-c)))
+      s=ss;c=cc
+      IF (err<=threshold) EXIT
+    ENDDO
+    quaderr_s=MAX(quaderr_s,err)
+  END SUBROUTINE
+
+  SUBROUTINE gaussian_once(n,lo,hi,eta,shift,mmax,s,c)
+    INTEGER, INTENT(IN) :: n,mmax
+    REAL(dp), INTENT(IN) :: lo,hi,eta,shift
+    REAL(dp), INTENT(OUT) :: s(-mmax:mmax),c(-mmax:mmax)
+    REAL(dp) :: xx(n),ww(n),u,w,co,si,cn,sn,ct
+    INTEGER :: j,m
+    CALL legendre(n,xx,ww);s=0;c=0
+    DO j=1,n
+      u=(hi+lo+(hi-lo)*xx(j))/2
+      w=ww(j)*(hi-lo)/2*EXP(-(eta*(u+shift))**2)
+      co=COS(2*pi*u);si=SIN(2*pi*u);cn=1;sn=0
+      DO m=0,mmax
+        s(m)=s(m)+w*sn;c(m)=c(m)+w*(1-u)*cn
+        ct=cn*co-sn*si;sn=sn*co+cn*si;cn=ct
+      ENDDO
+    ENDDO
+    DO m=1,mmax
+      s(-m)=-s(m);c(-m)=c(m)
+    ENDDO
+  END SUBROUTINE
+
+  SUBROUTINE sheet_moments(t,mmax,s,c,sr,cr,ierr)
+    REAL(dp), INTENT(IN) :: t
+    INTEGER, INTENT(IN) :: mmax
+    REAL(dp), INTENT(OUT) :: s(-mmax:mmax),c(-mmax:mmax),sr(-mmax:mmax),cr(-mmax:mmax)
+    INTEGER, INTENT(OUT) :: ierr
+    REAL(dp) :: eta,hi,ss(-mmax:mmax),cc(-mmax:mmax),ssr(-mmax:mmax),ccr(-mmax:mmax),err
+    INTEGER :: n
+    eta=t*lz_s;hi=MIN(.5_dp,tailcut/eta)
+    n=MAX(24,CEILING(2*REAL(mmax,dp)*hi)+16)
+    CALL sheet_once(n,hi,t,mmax,s,c,sr,cr)
+    DO
+      n=n*2
+      IF (n>2048) THEN
+        ierr=3;RETURN
+      ENDIF
+      CALL sheet_once(n,hi,t,mmax,ss,cc,ssr,ccr)
+      err=MAX(MAXVAL(ABS(ss-s)),MAXVAL(ABS(cc-c)),MAXVAL(ABS(ssr-sr)),MAXVAL(ABS(ccr-cr)))
+      s=ss;c=cc;sr=ssr;cr=ccr
+      IF (err<=MAX(3e-14_dp,tol_s*1e-4_dp)) EXIT
+    ENDDO
+    quaderr_s=MAX(quaderr_s,err)
+    ierr=0
+  END SUBROUTINE
+
+  SUBROUTINE sheet_once(n,hi,t,mmax,s,c,sr,cr)
+    INTEGER, INTENT(IN) :: n,mmax
+    REAL(dp), INTENT(IN) :: hi,t
+    REAL(dp), INTENT(OUT) :: s(-mmax:mmax),c(-mmax:mmax),sr(-mmax:mmax),cr(-mmax:mmax)
+    REAL(dp) :: xx(n),ww(n),u,w,f,fr,co,si,cn,sn,ct,v
+    INTEGER :: j,m
+    CALL legendre(n,xx,ww);s=0;c=0;sr=0;cr=0
+    DO j=1,n
+      u=hi*(1+xx(j))/2;w=hi*ww(j)/2
+      v=t*lz_s*u;f=EXP(-v*v)*sheet_minus_one(v,r0_s,t)
+      v=t*lz_s*(1-u)
+      IF (v>tailcut) THEN
+        fr=0
+      ELSE
+        fr=EXP(-v*v)*sheet_minus_one(v,r0_s,t)
+      ENDIF
+      co=COS(2*pi*u);si=SIN(2*pi*u);cn=1;sn=0
+      DO m=0,mmax
+        s(m)=s(m)+w*f*sn;c(m)=c(m)+w*f*u*cn
+        sr(m)=sr(m)+w*fr*sn;cr(m)=cr(m)+w*fr*u*cn
+        ct=cn*co-sn*si;sn=sn*co+cn*si;cn=ct
+      ENDDO
+    ENDDO
+    DO m=1,mmax
+      s(-m)=-s(m);c(-m)=c(m);sr(-m)=-sr(m);cr(-m)=cr(m)
+    ENDDO
+  END SUBROUTINE
+
+  REAL(dp) FUNCTION sheet_ratio(v,r0,t) RESULT(r)
+    REAL(dp), INTENT(IN) :: v,r0,t
+    REAL(dp) :: b,x,den,w
+    IF (r0==0) THEN
+      r=1;RETURN
+    ENDIF
+    IF (r0>HUGE(1._dp)/t) THEN
+      r=0;RETURN
+    ENDIF
+    b=r0*t
+    IF (b==0) THEN
+      r=1;RETURN
+    ENDIF
+    den=1+2*b*v
+    x=HUGE(1._dp)
+    IF (b>=.02_dp) x=v+0.5_dp/b
+    IF (x>25) THEN
+      w=(2*b/den)**2
+      r=(1+erfc_series_minus_one(w))/den
+    ELSE
+      r=sqrtpi/(2*b)*ERFC_SCALED(x)
+    ENDIF
+  END FUNCTION
+
+  REAL(dp) FUNCTION sheet_minus_one(v,r0,t) RESULT(r)
+    REAL(dp), INTENT(IN) :: v,r0,t
+    REAL(dp) :: b,x,den,w
+    IF (r0==0) THEN
+      r=0;RETURN
+    ENDIF
+    IF (r0>HUGE(1._dp)/t) THEN
+      r=-1;RETURN
+    ENDIF
+    b=r0*t
+    IF (b==0) THEN
+      r=0;RETURN
+    ENDIF
+    den=1+2*b*v
+    x=HUGE(1._dp)
+    IF (b>=.02_dp) x=v+0.5_dp/b
+    IF (x>25) THEN
+      w=(2*b/den)**2
+      r=-2*b*v/den+erfc_series_minus_one(w)/den
+    ELSE
+      r=sqrtpi/(2*b)*ERFC_SCALED(x)-1
+    ENDIF
+  END FUNCTION
+
+  REAL(dp) FUNCTION erfc_series_minus_one(w) RESULT(r)
+    REAL(dp), INTENT(IN) :: w
+    REAL(dp) :: term
+    INTEGER :: k
+    r=0;term=1
+    DO k=1,20
+      term=-term*REAL(2*k-1,dp)*w/2
+      r=r+term
+      IF (ABS(term)<EPSILON(1._dp)*MAX(ABS(r),TINY(1._dp))) EXIT
+    ENDDO
+  END FUNCTION
+
+  SUBROUTINE wlayer_block(ig,qfrac,scale,matrix,ierr,message)
+    INTEGER, INTENT(IN) :: ig(:,:)
+    REAL(dp), INTENT(IN) :: qfrac(3),scale
+    COMPLEX(dp), INTENT(OUT) :: matrix(:,:)
+    INTEGER, INTENT(OUT) :: ierr
+    CHARACTER(*), INTENT(OUT) :: message
+    REAL(dp), ALLOCATABLE :: weights(:),mat(:,:)
+    REAL(dp) :: qv(3),q2,x,p(2),phase
+    INTEGER :: modes(2),ix(2),mmax,n,k,i,j,ii,jj,nt
+    INTEGER(int64) :: need
+    ierr=0;message='';matrix=0
+    IF (.NOT.ready.OR.SIZE(ig,1)/=3.OR.SIZE(ig,2)/=SIZE(matrix,1).OR. &
+        SIZE(matrix,1)/=SIZE(matrix,2).OR..NOT.ALL(ieee_is_finite(qfrac)).OR. &
+        .NOT.ieee_is_finite(scale).OR.ABS(qfrac(3))>1e-10_dp) THEN
+      ierr=1;message='Invalid layered block shape, transfer or scale';RETURN
+    ENDIF
+    n=SIZE(ig,2)
+    IF (n==0) RETURN
+    IF (ANY(ig(1,:)/=ig(1,1)).OR.ANY(ig(2,:)/=ig(2,1))) THEN
+      ierr=1;message='Layered operator block mixes in-plane G vectors';RETURN
+    ENDIF
+    qv=2*pi*MATMUL(b_s,REAL(ig(1:2,1),dp)+qfrac(1:2));q2=SUM(qv*qv)
+    p=(REAL(ig(1:2,1),dp)+qfrac(1:2))*REAL(mesh_s(1:2),dp)
+    IF (MAXVAL(ABS(p))>1e9_dp) THEN
+      ierr=1;message='Layered reciprocal transfer is outside integer range';RETURN
+    ENDIF
+    modes=NINT(p)
+    IF (MAXVAL(ABS(p-REAL(modes,dp)))>1e-7_dp) THEN
+      ierr=1;message='Layered transfer is not commensurate with the in-plane mesh';RETURN
+    ENDIF
+    mmax=MAXVAL(ABS(ig(3,:)))
+    CALL ensure_modes(MAX(mmax,mmax_s),MAX(SQRT(q2),qmax_s),ierr,message)
+    IF (ierr/=0) RETURN
+    nt=SIZE(tl)+SIZE(xh)
+    need=bytes_s+reserve_input_s+8_int64*SIZE(mt,kind=int64)+8_int64*INT(2*mmax_s+1,int64)**2+16_int64*INT(n,int64)**2+8_int64*INT(nt,int64)
+    IF (need>memory_limit) THEN
+      ierr=2;message='Layered operator block exceeds workspace cap';RETURN
+    ENDIF
+    peak_s=MAX(peak_s,need)
+    ALLOCATE(weights(nt),mat(-mmax_s:mmax_s,-mmax_s:mmax_s))
+    weights=0
+    IF (.NOT.ANY(ABS(modes)>=grid_s/2)) THEN
+      ix=MODULO(modes,grid_s)+1
+      weights(1:SIZE(tl))=plane(ix(1),ix(2),:)
+    ENDIF
+    DO k=1,SIZE(xh)
+      x=SQRT(q2)*xh(k)/2
+      IF (x<tailcut) weights(SIZE(tl)+k)=EXP(-x*x)
+    ENDDO
+    CALL DGEMV('N',(2*mmax_s+1)**2,nt,1._dp,mt,(2*mmax_s+1)**2,weights,1,0._dp,mat,1)
+    DO j=1,n
+      jj=NINT(zsign_s*REAL(ig(3,j),dp))
+      DO i=1,n
+        ii=NINT(zsign_s*REAL(ig(3,i),dp))
+        phase=2*pi*REAL(jj-ii,dp)*MODULO(z0_s,lz_s)/lz_s
+        matrix(i,j)=scale*mat(ii,jj)*CMPLX(COS(phase),SIN(phase),dp)
+      ENDDO
+    ENDDO
+    IF (.NOT.ALL(ieee_is_finite(REAL(matrix,dp))).OR..NOT.ALL(ieee_is_finite(AIMAG(matrix)))) THEN
+      ierr=3;message='Layered operator block is nonfinite';matrix=0
+    ENDIF
+  END SUBROUTINE
+
+  SUBROUTINE wlayer_apply(ig,qfrac,density,scale,result,ierr,message,audit_unit)
+    INTEGER, INTENT(IN) :: ig(:,:)
+    REAL(dp), INTENT(IN) :: qfrac(3),scale
+    COMPLEX(dp), INTENT(IN) :: density(:,:)
+    COMPLEX(dp), INTENT(OUT) :: result(:,:)
+    INTEGER, INTENT(OUT) :: ierr
+    CHARACTER(*), INTENT(OUT) :: message
+    INTEGER, OPTIONAL, INTENT(IN) :: audit_unit
+    INTEGER, ALLOCATABLE :: order(:),subg(:,:)
+    COMPLEX(dp), ALLOCATABLE :: op(:,:),d(:,:),v(:,:)
+    INTEGER :: n,np,i,j,start,finish,ngroup,mmax,stat,largest
+    REAL(dp) :: qv(3),qmax
+    INTEGER(int64) :: need
+    ierr=0;message='';result=0;n=SIZE(ig,2);np=SIZE(density,2)
+    reserve_input_s=12_int64*INT(n,int64)
+    IF (.NOT.ready.OR.SIZE(ig,1)/=3.OR.SIZE(density,1)/=n.OR. &
+        ANY(SHAPE(result)/=SHAPE(density)).OR..NOT.ALL(ieee_is_finite(qfrac)).OR. &
+        ABS(qfrac(3))>1e-10_dp.OR..NOT.ieee_is_finite(scale)) THEN
+      ierr=1;message='Invalid layered density shape, transfer or scale';reserve_input_s=0;RETURN
+    ENDIF
+    DO j=1,np
+      DO i=1,n
+        IF (.NOT.ieee_is_finite(REAL(density(i,j),dp)).OR..NOT.ieee_is_finite(AIMAG(density(i,j)))) THEN
+          ierr=1;message='Layered density contains nonfinite values';reserve_input_s=0;RETURN
+        ENDIF
+      ENDDO
+    ENDDO
+    IF (n==0.OR.np==0) THEN
+      IF (PRESENT(audit_unit)) WRITE(audit_unit) INT(0,int32)
+      reserve_input_s=0;RETURN
+    ENDIF
+    qmax=0
+    DO i=1,n
+      qv=2*pi*MATMUL(b_s,REAL(ig(1:2,i),dp)+qfrac(1:2))
+      qmax=MAX(qmax,SQRT(SUM(qv*qv)))
+    ENDDO
+    mmax=MAXVAL(ABS(ig(3,:)))
+    CALL ensure_modes(mmax,qmax,ierr,message)
+    IF (ierr/=0) THEN
+      reserve_input_s=0;RETURN
+    ENDIF
+    IF (bytes_s+reserve_input_s+8_int64*INT(n,int64)>memory_limit) THEN
+      ierr=2;message='Layered G grouping exceeds workspace';reserve_input_s=0;RETURN
+    ENDIF
+    ALLOCATE(order(n),STAT=stat)
+    IF (stat/=0) THEN
+      ierr=2;message='Layered grouping allocation failed';reserve_input_s=0;RETURN
+    ENDIF
+    order=[(i,i=1,n)]
+    CALL sort_indices(order,ig,1,n)
+    ngroup=1;largest=1;start=1
+    DO i=2,n
+      IF (ALL(ig(:,order(i))==ig(:,order(i-1)))) THEN
+        ierr=1;message='Duplicate G vector in layered density';reserve_input_s=0;RETURN
+      ENDIF
+      IF (ANY(ig(1:2,order(i))/=ig(1:2,order(i-1)))) THEN
+        ngroup=ngroup+1;largest=MAX(largest,i-start);start=i
+      ENDIF
+    ENDDO
+    largest=MAX(largest,n-start+1)
+    need=bytes_s+reserve_input_s+8_int64*INT(n,int64)+32_int64*INT(largest,int64)**2+ &
+      64_int64*INT(largest,int64)*INT(np,int64)+12_int64*INT(largest,int64)+ &
+      8_int64*INT(2*mmax_s+1,int64)**2+8_int64*INT(SIZE(tl)+SIZE(xh),int64)+ &
+      8_int64*SIZE(mt,kind=int64)
+    IF (need>memory_limit) THEN
+      ierr=2;message='Layered application exceeds 512 MiB additional workspace';reserve_input_s=0;RETURN
+    ENDIF
+    peak_s=MAX(peak_s,need)
+    IF (PRESENT(audit_unit)) WRITE(audit_unit) INT(ngroup,int32)
+    start=1
+    DO WHILE(start<=n)
+      finish=start
+      DO WHILE(finish<n)
+        IF (ANY(ig(1:2,order(finish+1))/=ig(1:2,order(start)))) EXIT
+        finish=finish+1
+      ENDDO
+      j=finish-start+1
+      ALLOCATE(op(j,j),subg(3,j),d(j,np),v(j,np))
+      DO i=1,j
+        subg(:,i)=ig(:,order(start+i-1))
+      ENDDO
+      DO ngroup=1,np
+        DO i=1,j
+          d(i,ngroup)=density(order(start+i-1),ngroup)
+        ENDDO
+      ENDDO
+      CALL wlayer_block(subg,qfrac,scale,op,ierr,message)
+      IF (ierr/=0) THEN
+      reserve_input_s=0;RETURN
+    ENDIF
+      CALL ZGEMM('N','N',j,np,j,CMPLX(1._dp,0._dp,dp),op,j,d,j,CMPLX(0._dp,0._dp,dp),v,j)
+      DO ngroup=1,np
+        DO i=1,j
+          result(order(start+i-1),ngroup)=v(i,ngroup)
+        ENDDO
+      ENDDO
+      IF (PRESENT(audit_unit)) THEN
+        WRITE(audit_unit) INT(j,int32),INT(order(start:finish),int32),op
+      ENDIF
+      DEALLOCATE(op,subg,d,v)
+      start=finish+1
+    ENDDO
+    reserve_input_s=0
+  END SUBROUTINE
+
+  RECURSIVE SUBROUTINE sort_indices(idx,g,lo,hi)
+    INTEGER, INTENT(INOUT) :: idx(:)
+    INTEGER, INTENT(IN) :: g(:,:),lo,hi
+    INTEGER :: i,j,p,tmp
+    IF (lo>=hi) RETURN
+    p=idx((lo+hi)/2);i=lo;j=hi
+    DO
+      DO WHILE(less(g(:,idx(i)),g(:,p)))
+        i=i+1
+      ENDDO
+      DO WHILE(less(g(:,p),g(:,idx(j))))
+        j=j-1
+      ENDDO
+      IF (i<=j) THEN
+        tmp=idx(i);idx(i)=idx(j);idx(j)=tmp;i=i+1;j=j-1
+      ENDIF
+      IF (i>j) EXIT
+    ENDDO
+    IF (lo<j) CALL sort_indices(idx,g,lo,j)
+    IF (i<hi) CALL sort_indices(idx,g,i,hi)
+  END SUBROUTINE
+
+  LOGICAL FUNCTION less(a,b)
+    INTEGER, INTENT(IN) :: a(3),b(3)
+    INTEGER :: i
+    less=.false.
+    DO i=1,3
+      IF (a(i)<b(i)) THEN
+        less=.true.;RETURN
+      ELSE IF (a(i)>b(i)) THEN
+        RETURN
+      ENDIF
+    ENDDO
+  END FUNCTION
+
+  RECURSIVE PURE SUBROUTINE reduce2(a,b,ierr)
+    REAL(dp), INTENT(INOUT) :: a(3),b(3)
+    INTEGER, INTENT(OUT) :: ierr
+    REAL(dp) :: tmp(3),aa,bb,mu
+    INTEGER :: i
+    ierr=0
+    DO i=1,256
+      aa=SUM(a*a);bb=SUM(b*b)
+      IF (aa<=0.OR.bb<=0) EXIT
+      IF (bb<aa) THEN
+        tmp=a;a=b;b=tmp;aa=SUM(a*a)
+      ENDIF
+      ! At a hexagonal tie ANINT(+/-1/2) alternates two equivalent bases.
+      ! Stop within roundoff; shortest2 independently certifies the metric
+      ! used by the real-space radius and reciprocal alias bound.
+      IF (ABS(DOT_PRODUCT(a,b))<=0.5_dp*aa*(1+8*EPSILON(1._dp))) RETURN
+      mu=ANINT(DOT_PRODUCT(a,b)/aa)
+      IF (mu==0) RETURN
+      b=b-mu*a
+    ENDDO
+    ierr=1
+  END SUBROUTINE
+
+  RECURSIVE PURE REAL(dp) FUNCTION shortest2(a,b) RESULT(rr)
+    REAL(dp), INTENT(IN) :: a(3),b(3)
+    REAL(dp) :: e(3),v(3),r11,r12,r22
+    INTEGER :: j,lim,n1
+    r11=NORM2(a);e=a/r11;r12=DOT_PRODUCT(e,b)
+    r22=NORM2(b-r12*e);rr=MIN(SUM(a*a),SUM(b*b))
+    ! QR bounds enumerate every vector shorter than the current candidate.
+    lim=FLOOR(SQRT(rr)/r22)+1
+    DO j=-lim,lim
+      IF (j==0) THEN
+        n1=1
+      ELSE
+        n1=NINT(-REAL(j,dp)*r12/r11)
+      ENDIF
+      v=REAL(n1,dp)*a+REAL(j,dp)*b;rr=MIN(rr,SUM(v*v))
+    ENDDO
+  END FUNCTION
+
+  REAL(dp) FUNCTION nearest2(x,a,b) RESULT(rr)
+    REAL(dp), INTENT(IN) :: x(3),a(3),b(3)
+    REAL(dp) :: e1(3),v2(3),r11,r12,r22,y1,y2,v(3),rad
+    INTEGER(int64) :: j,n1,j0,lo,hi
+    r11=SQRT(SUM(a*a));e1=a/r11;r12=DOT_PRODUCT(e1,b)
+    v2=b-r12*e1;r22=SQRT(SUM(v2*v2));v2=v2/r22
+    y1=DOT_PRODUCT(e1,x);y2=DOT_PRODUCT(v2,x);j0=NINT(y2/r22,kind=int64)
+    n1=NINT((y1-REAL(j0,dp)*r12)/r11,kind=int64)
+    v=x-REAL(n1,dp)*a-REAL(j0,dp)*b;rr=SUM(v*v)
+    rad=SQRT(MAX(0._dp,rr));lo=CEILING((y2-rad)/r22,kind=int64);hi=FLOOR((y2+rad)/r22,kind=int64)
+    DO j=lo,hi
+      n1=NINT((y1-REAL(j,dp)*r12)/r11,kind=int64)
+      v=x-REAL(n1,dp)*a-REAL(j,dp)*b;rr=MIN(rr,SUM(v*v))
+    ENDDO
+  END FUNCTION
+
+  FUNCTION cross(a,b) RESULT(c)
+    REAL(dp), INTENT(IN) :: a(3),b(3)
+    REAL(dp) :: c(3)
+    c=[a(2)*b(3)-a(3)*b(2),a(3)*b(1)-a(1)*b(3),a(1)*b(2)-a(2)*b(1)]
+  END FUNCTION
+
+  INTEGER FUNCTION parity(i)
+    INTEGER, INTENT(IN) :: i
+    parity=1
+    IF (MODULO(i,2)/=0) parity=-1
+  END FUNCTION
+
+  REAL(dp) FUNCTION sinc(x)
+    REAL(dp), INTENT(IN) :: x
+    IF (ABS(x)<1e-4_dp) THEN
+      sinc=1-x*x/6+x**4/120-x**6/5040
+    ELSE
+      sinc=SIN(x)/x
+    ENDIF
+  END FUNCTION
+
+  SUBROUTINE legendre(n,x,w)
+    INTEGER, INTENT(IN) :: n
+    REAL(dp), INTENT(OUT) :: x(n),w(n)
+    REAL(dp) :: z,zold,p1,p2,p3,pp
+    INTEGER :: i,j,it
+    DO i=1,(n+1)/2
+      z=COS(pi*(REAL(i,dp)-.25_dp)/(REAL(n,dp)+.5_dp))
+      DO it=1,64
+        p1=1;p2=0
+        DO j=1,n
+          p3=p2;p2=p1;p1=((2*j-1)*z*p2-(j-1)*p3)/j
+        ENDDO
+        pp=n*(z*p1-p2)/(z*z-1);zold=z;z=zold-p1/pp
+        IF (ABS(z-zold)<3e-16_dp) EXIT
+      ENDDO
+      x(i)=-z;x(n+1-i)=z;w(i)=2/((1-z*z)*pp*pp);w(n+1-i)=w(i)
+    ENDDO
+  END SUBROUTINE
+
+  SUBROUTINE fft1(a)
+    COMPLEX(dp), INTENT(INOUT) :: a(:)
+    INTEGER :: n,i,j,k,m,half,step
+    COMPLEX(dp) :: temp,u,w,wn
+    n=SIZE(a);j=1
+    DO i=1,n
+      IF (i<j) THEN
+        temp=a(i);a(i)=a(j);a(j)=temp
+      ENDIF
+      m=n/2
+      DO WHILE(m>=1)
+        IF (j<=m) EXIT
+        j=j-m;m=m/2
+      ENDDO
+      j=j+m
+    ENDDO
+    step=2
+    DO WHILE(step<=n)
+      half=step/2;wn=CMPLX(COS(2*pi/step),-SIN(2*pi/step),dp)
+      DO i=1,n,step
+        w=1
+        DO k=0,half-1
+          u=a(i+k);temp=w*a(i+k+half)
+          a(i+k)=u+temp;a(i+k+half)=u-temp;w=w*wn
+        ENDDO
+      ENDDO
+      step=step*2
+    ENDDO
+  END SUBROUTINE
+END MODULE wint_layered
