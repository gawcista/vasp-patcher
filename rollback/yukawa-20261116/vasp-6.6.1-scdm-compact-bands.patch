+    ! All WINT tags are opt-in, even BARE. Parse them before LHFCALC dispatch
+    ! so an invalid/unsupported ordinary PBE input cannot silently disappear.
+    SUBROUTINE WINT_READ_KERNEL_INPUT(LOPEN,IU0,IU5)
+      USE reader_tags
+      USE chi_glb, ONLY: L2E4W_ALL,LCRPA
+      USE string, ONLY: uppercase
+      USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
+      USE tutor, ONLY: vtutor
+      IMPLICIT NONE
+      LOGICAL, INTENT(IN) :: LOPEN
+      INTEGER, INTENT(IN) :: IU0,IU5
+      LOGICAL :: HAS_KERNEL,HAS_KAPPA,HAS_EPS
+      INTEGER :: IERR,N
+      REAL(q) :: REQUESTED_CUTOFF
+      CHARACTER(64) :: NAME
+      CHARACTER(:), ALLOCATABLE :: PARSE_ERRORS
+
+      ! The native reader drops unassigned tags from incar_f%tags and keeps
+      ! their structured diagnostics in incar_f%error. Reserved empty inputs
+      ! must fail even when a later duplicate supplies a valid value.
+      IF (ALLOCATED(incar_f%error)) THEN
+         PARSE_ERRORS=UPPERCASE(incar_f%error)
+         IF (INDEX(PARSE_ERRORS,'TAG WINT_KERNEL IS NOT ASSIGNED.')>0) &
+            CALL vtutor%error('WINT_KERNEL requires one model name: BARE or YUKAWA')
+         IF (INDEX(PARSE_ERRORS,'TAG WINT_KAPPA IS NOT ASSIGNED.')>0) &
+            CALL vtutor%error('WINT_KAPPA requires one finite nonnegative value in Angstrom^-1')
+         IF (INDEX(PARSE_ERRORS,'TAG WINT_EPS IS NOT ASSIGNED.')>0) &
+            CALL vtutor%error('WINT_EPS requires one finite positive relative permittivity')
+      ENDIF
+      HAS_KERNEL=WINT_TAG_PRESENT('WINT_KERNEL')
+      HAS_KAPPA=WINT_TAG_PRESENT('WINT_KAPPA')
+      HAS_EPS=WINT_TAG_PRESENT('WINT_EPS')
+      IF (.NOT.(HAS_KERNEL.OR.HAS_KAPPA.OR.HAS_EPS)) RETURN
+      WINT_ENABLED=.TRUE.
+      NAME='BARE'
+      IF (HAS_KERNEL) THEN
+         CALL PROCESS_INCAR(LOPEN,IU0,IU5,'WINT_KERNEL',NAME,64,IERR,WRITEXMLINCAR, &
+                            LCONTINUE=.TRUE.,FOUNDNUMBER=N)
+         IF (IERR/=0.OR.N/=1) CALL vtutor%error('WINT_KERNEL requires one model name: BARE or YUKAWA')
+      ENDIF
+      NAME=UPPERCASE(TRIM(ADJUSTL(NAME)))
+      SELECT CASE(TRIM(NAME))
+      CASE('BARE')
+         WINT_MODEL=WINT_MODEL_BARE
+      CASE('YUKAWA')
+         WINT_MODEL=WINT_MODEL_YUKAWA
+      CASE DEFAULT
+         CALL vtutor%error('Unknown WINT_KERNEL: '//TRIM(NAME)//'; supported models are BARE and YUKAWA')
+      END SELECT
+      IF (HAS_KAPPA) THEN
+         CALL PROCESS_INCAR(LOPEN,IU0,IU5,'WINT_KAPPA',WINT_KAPPA,IERR,WRITEXMLINCAR, &
+                            LCONTINUE=.TRUE.,FOUNDNUMBER=N)
+         IF (IERR/=0.OR.N/=1) CALL vtutor%error('WINT_KAPPA requires one finite nonnegative value in Angstrom^-1')
+         IF (.NOT.IEEE_IS_FINITE(WINT_KAPPA).OR.WINT_KAPPA<0._q) &
+            CALL vtutor%error('WINT_KAPPA must be finite and >= 0 Angstrom^-1')
+      ENDIF
+      IF (HAS_EPS) THEN
+         CALL PROCESS_INCAR(LOPEN,IU0,IU5,'WINT_EPS',WINT_EPS,IERR,WRITEXMLINCAR, &
+                            LCONTINUE=.TRUE.,FOUNDNUMBER=N)
+         IF (IERR/=0.OR.N/=1) CALL vtutor%error('WINT_EPS requires one finite positive relative permittivity')
+         IF (.NOT.IEEE_IS_FINITE(WINT_EPS).OR.WINT_EPS<=0._q) &
+            CALL vtutor%error('WINT_EPS must be finite and > 0 (dimensionless)')
+      ENDIF
+      IF (WINT_MODEL==WINT_MODEL_BARE.AND.(HAS_KAPPA.OR.HAS_EPS)) &
+         CALL vtutor%error('WINT_KERNEL=BARE does not accept WINT_KAPPA or WINT_EPS')
+      IF (WINT_MODEL==WINT_MODEL_YUKAWA.AND..NOT.HAS_KAPPA) &
+         CALL vtutor%error('WINT_KERNEL=YUKAWA requires explicit WINT_KAPPA in Angstrom^-1')
+      IF (.NOT.L2E4W_ALL.OR.LCRPA) &
+         CALL vtutor%error('WINT_KERNEL parameters require native ALGO=2E4WA without cRPA')
+      REQUESTED_CUTOFF=0._q
+      CALL PROCESS_INCAR(LOPEN,IU0,IU5,'HFRCUT',REQUESTED_CUTOFF,IERR,WRITEXMLINCAR, &
+                         LCONTINUE=.TRUE.,FOUNDNUMBER=N)
+      IF (IERR/=0.OR.N/=1.OR.REQUESTED_CUTOFF/=-2._q) &
+         CALL vtutor%error('WINT_KERNEL parameters require HFRCUT=-2 (Wigner-Seitz cutoff)')
+    END SUBROUTINE WINT_READ_KERNEL_INPUT
