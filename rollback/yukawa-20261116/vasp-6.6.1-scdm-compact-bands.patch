+    SUBROUTINE SET_GFAC_WAVEFUN_WS(WDES1,LATT_CUR,POTFAK)
+      USE constant, ONLY: PI,TPI,EDEPS
+      USE wave, ONLY: wavedes1
+      USE lattice, ONLY: latt
+      USE ws_coulomb, ONLY: ws_get
+      USE tutor, ONLY: vtutor
+      IMPLICIT NONE
+      TYPE(wavedes1), INTENT(IN) :: WDES1
+      TYPE(latt), INTENT(IN) :: LATT_CUR
+      REAL(q), INTENT(OUT) :: POTFAK(WDES1%NGVECTOR)
+      REAL(q) :: QV(3), VALUE, SCALE_WS
+      INTEGER :: NI,IERR
+      CALL WS_PREPARE_KERNEL(LATT_CUR,-1)
+      SCALE_WS=EDEPS/(4*PI*LATT_CUR%OMEGA*REAL(WDES1%GRID%NPLWV,q))
+      DO NI=1,WDES1%NGVECTOR
+         QV=TPI*MATMUL(LATT_CUR%B,WDES1%VKPT+REAL([WDES1%IGX(NI),WDES1%IGY(NI),WDES1%IGZ(NI)],q))
+         CALL ws_get(QV,VALUE,IERR)
+         IF (IERR/=0) CALL vtutor%error('WS Fourier query is not commensurate with the supported Gamma mesh')
+         POTFAK(NI)=SCALE_WS*VALUE
+      ENDDO
+    END SUBROUTINE SET_GFAC_WAVEFUN_WS
+
+    SUBROUTINE SET_GFAC_WINT_REMAINDER(WDES1,LATT_CUR,POTFAK)
+      USE constant, ONLY: PI,TPI,EDEPS
+      USE wave, ONLY: wavedes1
+      USE lattice, ONLY: latt
+      USE ws_coulomb, ONLY: ws_get_pair
+      USE, INTRINSIC :: ieee_arithmetic, ONLY: ieee_is_finite
+      USE tutor, ONLY: vtutor
+      IMPLICIT NONE
+      TYPE(wavedes1), INTENT(IN) :: WDES1
+      TYPE(latt), INTENT(IN) :: LATT_CUR
+      REAL(q), INTENT(OUT) :: POTFAK(WDES1%NGVECTOR)
+      REAL(q) :: QV(3),BARE,REMAINDER,SCALE_WS
+      INTEGER :: NI,IERR
+      POTFAK=0._q
+      IF (WINT_MODEL==WINT_MODEL_BARE) RETURN
+      CALL WS_PREPARE_KERNEL(LATT_CUR,-1)
+      SCALE_WS=EDEPS/(4*PI*LATT_CUR%OMEGA*REAL(WDES1%GRID%NPLWV,q))
+      DO NI=1,WDES1%NGVECTOR
+         QV=TPI*MATMUL(LATT_CUR%B,WDES1%VKPT+REAL([WDES1%IGX(NI),WDES1%IGY(NI),WDES1%IGZ(NI)],q))
+         CALL ws_get_pair(QV,BARE,REMAINDER,IERR)
+         IF (IERR/=0) CALL vtutor%error('WINT remainder Fourier query failed: noncommensurate q or coefficient overflow')
+         POTFAK(NI)=SCALE_WS*REMAINDER
+         IF (.NOT.IEEE_IS_FINITE(POTFAK(NI))) CALL vtutor%error('WINT remainder native coefficient overflow')
+      ENDDO
+    END SUBROUTINE SET_GFAC_WINT_REMAINDER
