+    LOGICAL FUNCTION WINT_TAG_PRESENT(KEY)
+      USE reader_tags, ONLY: incar_f,COUNT_ELEMENTS
+      USE string, ONLY: uppercase
+      IMPLICIT NONE
+      CHARACTER(*), INTENT(IN) :: KEY
+      INTEGER :: I
