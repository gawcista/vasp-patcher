+  SUBROUTINE WINT_AUDIT_QBLOCK(WDES,WQ,NQ,NW,TARGET,DENSITY,WORK,MATRIX,SCALE,LATT_CUR)
+    USE iso_fortran_env, ONLY: int32
+    TYPE(wavedes), INTENT(IN) :: WDES
