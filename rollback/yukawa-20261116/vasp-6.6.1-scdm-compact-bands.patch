+ !> Select safe SCDM cutoff semantics when Wannier90 excludes bands
+ SUBROUTINE CUTOFF_DES_PREPARE_SCDM(CUTOFF_DES,EXCLUDE_BAND,NUM_WANN,NEEDS_ESTIMATE,IO)
+   USE tutor, ONLY : vtutor
+   USE base,   ONLY : in_struct
+
+   TYPE(cutoff_type),INTENT(INOUT) :: CUTOFF_DES
+   LOGICAL,INTENT(IN) :: EXCLUDE_BAND(:)
+   INTEGER,INTENT(IN) :: NUM_WANN
+   LOGICAL,INTENT(OUT) :: NEEDS_ESTIMATE
+   TYPE(in_struct),INTENT(IN) :: IO
+
+   INTEGER :: NB_SCDM
+   LOGICAL :: COMPLETE,EXPLICIT_REQUEST
+
+   NEEDS_ESTIMATE = .TRUE.
+   IF (.NOT. ANY(EXCLUDE_BAND)) RETURN
+
+   NB_SCDM = COUNT(.NOT. EXCLUDE_BAND)
+   EXPLICIT_REQUEST = CUTOFF_DES%MU_EXPLICIT .OR. CUTOFF_DES%SIGMA_EXPLICIT .OR. &
+                      CUTOFF_DES%TYPE_EXPLICIT
+   NEEDS_ESTIMATE = .FALSE.
+
+   IF (.NOT. EXPLICIT_REQUEST) THEN
+      IF (NB_SCDM == NUM_WANN) THEN
+         CUTOFF_DES%TYPE = CUTOFF_NONE
+         IF (IO%IU6>=0) WRITE(IO%IU6,'(A)') &
+            ' SCDM: no energy cutoff is applied within the selected subspace (NB_SCDM == NUM_WANN)'
+         RETURN
+      ENDIF
+      CALL vtutor%error( &
+         "SCDM with exclude_bands: automatic cutoff estimation is not supported for an entangled compact subspace")
+   ENDIF
+
+   IF (.NOT. CUTOFF_DES%TYPE_VALID) CALL vtutor%error( &
+      "SCDM with exclude_bands: explicit cutoff parameters are incomplete or the cutoff type is unsupported")
+
+   ! Historically explicit MU and SIGMA without CUTOFF_TYPE select ERFC.
+   IF (.NOT. CUTOFF_DES%TYPE_EXPLICIT .AND. CUTOFF_DES%MU_EXPLICIT .AND. &
+       CUTOFF_DES%SIGMA_EXPLICIT) CUTOFF_DES%TYPE = CUTOFF_ERFC
+
+   SELECT CASE (CUTOFF_DES%TYPE)
+      CASE (CUTOFF_NONE)
+         COMPLETE = CUTOFF_DES%TYPE_EXPLICIT
+      CASE (CUTOFF_ERFC,CUTOFF_GAUSSIAN)
+         COMPLETE = CUTOFF_DES%MU_EXPLICIT .AND. CUTOFF_DES%SIGMA_EXPLICIT
+      CASE (CUTOFF_FERMI)
+         COMPLETE = CUTOFF_DES%MU_EXPLICIT
+      CASE (CUTOFF_NUM_WANN)
+         COMPLETE = CUTOFF_DES%SIGMA_EXPLICIT
+      CASE DEFAULT
+         COMPLETE = .FALSE.
+   END SELECT
+
+   IF (.NOT. COMPLETE) CALL vtutor%error( &
+      "SCDM with exclude_bands: explicit cutoff parameters are incomplete " // &
+      "(TYPE=erfc/gaussian require CUTOFF_MU and CUTOFF_SIGMA, TYPE=fermi requires CUTOFF_MU, " // &
+      "TYPE=num_wann requires CUTOFF_SIGMA); automatic estimation is disabled")
+
+   IF (IO%IU6>=0) THEN
+      IF (CUTOFF_DES%TYPE==CUTOFF_NONE) THEN
+         WRITE(IO%IU6,'(A)') &
+            ' SCDM: explicit CUTOFF_TYPE = none, unit weights are used for the selected bands'
+      ELSE
+         WRITE(IO%IU6,'(A)') &
+            ' SCDM: explicit cutoff parameters are used, evaluated on the selected bands'
+      ENDIF
+   ENDIF
+ END SUBROUTINE CUTOFF_DES_PREPARE_SCDM
 
