+    TYPE(latt), INTENT(IN) :: LATT_CUR
+    INTEGER, INTENT(IN) :: NQ,NW
+    REAL(q), INTENT(IN) :: TARGET(:),SCALE
+    COMPLEX(q), INTENT(IN) :: DENSITY(:,:)
+    COMPLEX(q), INTENT(INOUT) :: WORK(:,:)
+    GDEF, INTENT(IN) :: MATRIX(:,:,:,:)
+    GDEF :: FULL_BARE(NW,NW,NW,NW)
+    REAL(q), ALLOCATABLE :: BARE(:)
