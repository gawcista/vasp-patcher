+    IF (ASSOCIATED(WDES%COMM)) LAYOUT(8:9)=[WDES%COMM%NODE_ME,WDES%COMM%NCPU]
+    WRITE(FILENAME,'(A,A,I5.5,A,I5.5,A)') TRIM(DIRECTORY),'/q',NQ,'-rank',WDES%COMM%NODE_ME,'.bin'
+    OPEN(NEWUNIT=IUNIT,FILE=TRIM(FILENAME),ACCESS='STREAM',FORM='UNFORMATTED',STATUS='REPLACE',IOSTAT=IOS)
+    IF (IOS/=0) CALL vtutor%error('Could not open explicitly requested full-density q-block diagnostic')
+    WRITE(IUNIT) INT([2,SIZE(TARGET),NW,NQ,WDES%NKPTS,GRIDHF%NPLWV,WQ%GRID%NPLWV,LAYOUT],int32)
