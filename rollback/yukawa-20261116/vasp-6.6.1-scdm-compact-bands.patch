+    WRITE(IUNIT) WQ%IGX(1:SIZE(TARGET)),WQ%IGY(1:SIZE(TARGET)),WQ%IGZ(1:SIZE(TARGET))
+    WRITE(IUNIT) BARE,TARGET,DENSITY,FULL_BARE,MATRIX
+    CLOSE(IUNIT)
+    DEALLOCATE(BARE)
+#endif
+  END SUBROUTINE
