+! Original private WS Wannier-integral entry; legacy Fock kernels are unchanged.
+    SUBROUTINE WS_PREPARE_KERNEL(LATT_CUR, IU6)
+      USE constant, ONLY: PI, EDEPS
+      USE lattice, ONLY: latt
+      USE full_kpoints, ONLY: KPOINTS_FULL, CHECK_FULL_KPOINTS
+      USE ws_coulomb, ONLY: ws_init, ws_get, ws_info
+      USE iso_fortran_env, ONLY: int64
+      USE tutor, ONLY: vtutor
+      IMPLICIT NONE
+      TYPE(latt), INTENT(IN) :: LATT_CUR
+      INTEGER, INTENT(IN) :: IU6
+      INTEGER :: NK(3), I, IERR, NG(3)
+      INTEGER(int64) :: BYTES
+      REAL(q) :: A(3,3), ALPHA, RIN, VOLUME, HEAD
+      CHARACTER(512) :: MSG
+      LOGICAL, SAVE :: REPORTED=.FALSE.
+      REAL(q), SAVE :: REPORTED_A(3,3)=0, REPORTED_TOL=0
+      INTEGER, SAVE :: REPORTED_GRID(3)=0
+
+      IF (WINT_CUTOFF_MODE/=WINT_CUTOFF_WS) &
+         CALL vtutor%error('WS kernel requested without HFRCUT=-2')
+      CALL CHECK_FULL_KPOINTS
+      NK=[KPOINTS_FULL%NKPX,KPOINTS_FULL%NKPY,KPOINTS_FULL%NKPZ]
+      IF (ANY(NK<1)) CALL vtutor%error('WS requires a regular automatic Gamma-centered k mesh')
+      IF (KPOINTS_FULL%NKPTS_NON_ZERO/=PRODUCT(NK)) &
+         CALL vtutor%error('WS requires a complete uniform three-dimensional mesh descriptor')
+      IF (NKREDX/=1.OR.NKREDY/=1.OR.NKREDZ/=1.OR.HFKIDENT.OR.SHIFTRED.OR.ODDONLY.OR.EVENONLY) &
+         CALL vtutor%error('Stage-1 WS does not support Fock mesh reduction or shifted/odd/even grids')
+      IF (HFSCREEN/=0._q.OR.MODEL_GW/=0.OR.L_THOMAS_FERMI.OR.LRHFCALC.OR.L_MODEL_HF) &
+         CALL vtutor%error('Stage-1 WS requires the bare integral kernel')
+      IF (ABS(AEXX-1._q)>1.0e-12_q) CALL vtutor%error('WS Wannier integrals require full Coulomb strength AEXX=1')
+      DO I=1,3
+         A(:,I)=LATT_CUR%A(:,I)*REAL(NK(I),q)
+      ENDDO
+      CALL ws_init(A,WS_TOL,WS_NGRID,IERR,MSG)
+      IF (IERR/=0) CALL vtutor%error('WS construction failed: '//TRIM(MSG))
+      CALL ws_info(NG,ALPHA,RIN,VOLUME,BYTES)
+      IF (.NOT.REPORTED.OR.ANY(A/=REPORTED_A).OR.WS_TOL/=REPORTED_TOL.OR.ANY(WS_NGRID/=REPORTED_GRID)) THEN
+         IF (IU6>=0) THEN
+            CALL ws_get([0._q,0._q,0._q],HEAD,IERR)
+            IF (IERR/=0) CALL vtutor%error('WS head evaluation failed')
+            WRITE(IU6,'(A)') ' WS_COULOMB_STAGE1 v1: HFRCUT=-2, full real-space BvK WS, bare Coulomb'
+            WRITE(IU6,'(A,3I8)') ' WS mesh: ',NK
+            WRITE(IU6,'(A,3I8)') ' WS FFT grid: ',NG
+            WRITE(IU6,'(A,ES16.8)') ' WS_TOL (MIC range/bandwidth control): ',WS_TOL
+            WRITE(IU6,'(A,ES16.8)') ' WS alpha [1/Angstrom]: ',ALPHA
+            WRITE(IU6,'(A,ES16.8)') ' WS inradius [Angstrom]: ',RIN
+            WRITE(IU6,'(A,ES16.8)') ' WS supercell volume [Angstrom^3]: ',VOLUME
+            WRITE(IU6,'(A,ES16.8)') ' WS head/(Omega*Nq) [eV]: ',HEAD*EDEPS/(4*PI*VOLUME)
+            WRITE(IU6,'(A,I18)') ' WS replicated cache [bytes/rank]: ',BYTES
+            DO I=1,3
+               WRITE(IU6,'(A,I1,A,3F18.9)') ' WS lattice vector ',I,' [Angstrom]: ',A(:,I)
+            ENDDO
+            WRITE(IU6,'(A)') ' WS mode: no old Ewald/FSG head; converge finite-density and WS-face errors with WS_NGRID'
+            REPORTED=.TRUE.; REPORTED_A=A; REPORTED_TOL=WS_TOL; REPORTED_GRID=WS_NGRID
+         ENDIF
+      ENDIF
+    END SUBROUTINE WS_PREPARE_KERNEL
+
+    SUBROUTINE SET_GFAC_WAVEFUN_WS(WDES1,LATT_CUR,POTFAK)
+      USE constant, ONLY: PI,TPI,EDEPS
+      USE wave, ONLY: wavedes1
+      USE lattice, ONLY: latt
+      USE ws_coulomb, ONLY: ws_get
+      USE tutor, ONLY: vtutor
+      IMPLICIT NONE
+      TYPE(wavedes1), INTENT(IN) :: WDES1
+      TYPE(latt), INTENT(IN) :: LATT_CUR
+      REAL(q), INTENT(OUT) :: POTFAK(WDES1%NGVECTOR)
+      REAL(q) :: QV(3), VALUE, SCALE_WS
+      INTEGER :: NI,IERR
+      CALL WS_PREPARE_KERNEL(LATT_CUR,-1)
+      SCALE_WS=EDEPS/(4*PI*LATT_CUR%OMEGA*REAL(WDES1%GRID%NPLWV,q))
+      DO NI=1,WDES1%NGVECTOR
+         QV=TPI*MATMUL(LATT_CUR%B,WDES1%VKPT+REAL([WDES1%IGX(NI),WDES1%IGY(NI),WDES1%IGZ(NI)],q))
+         CALL ws_get(QV,VALUE,IERR)
+         IF (IERR/=0) CALL vtutor%error('WS Fourier query is not commensurate with the supported Gamma mesh')
+         POTFAK(NI)=SCALE_WS*VALUE
+      ENDDO
+    END SUBROUTINE SET_GFAC_WAVEFUN_WS
+
