+! Original standalone MIC construction following Sundararaman and Arias,
+! Phys. Rev. B 87, 165122 (2013), Appendix A.1. No VASP dependencies.
+!
+! A contains the BvK superlattice vectors as COLUMNS, in Angstrom.
+! q is Cartesian inverse Angstrom; ws_get returns integral_WS exp(-iq.r)/r
+! in Angstrom**2 (the physical Coulomb constant is applied by the caller).
+! Only reciprocal vectors of this superlattice are valid queries.
+!
+! tol controls the erfc range separation and smooth-part bandwidth. It is
+! NOT a uniform error bound on individual Fourier coefficients: periodic
+! WS-face derivative cusps produce quadrature errors. Converge head/edges
+! and density contractions independently with WS_NGRID. At and outside
+! the FFT Nyquist faces only the analytic short-range term is returned.
+!
+! The saved cache is process-local. Initialize/reset outside threaded query
+! regions; ws_get is read-only and safe for parallel queries after ws_init.
+module ws_coulomb
+  use iso_fortran_env, only: real64, int64
+  use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+  implicit none
+  private
+  public :: ws_init, ws_get, ws_info, ws_reset
+  integer, parameter :: dp=real64
+  real(dp), parameter :: pi=acos(-1.0_dp)
+  integer(int64), parameter :: memory_limit=536870912_int64 ! 512 MiB per process
+  real(dp), save :: lattice(3,3)=0, saved_tol=0, alpha_saved=0, rin_saved=0, volume_saved=0
+  integer, save :: shape_saved(3)=0, requested_grid(3)=0
+  integer(int64), save :: bytes_saved=0
+  logical, save :: ready=.false.
+  complex(dp), allocatable, save :: coefficients(:,:,:)
+contains
+
+  subroutine ws_reset()
+    if (allocated(coefficients)) deallocate(coefficients)
+    ready=.false.
+    lattice=0; saved_tol=0; alpha_saved=0; rin_saved=0; volume_saved=0
+    shape_saved=0; requested_grid=0; bytes_saved=0
+  end subroutine
+
+  subroutine ws_info(ngrid,alpha,rin,volume,bytes)
+    integer, intent(out) :: ngrid(3)
+    real(dp), intent(out) :: alpha,rin,volume
+    integer(int64), intent(out) :: bytes
+    ngrid=shape_saved; alpha=alpha_saved; rin=rin_saved; volume=volume_saved; bytes=bytes_saved
+  end subroutine
+
+  subroutine ws_init(a_super,tol,grid_override,ierr,message)
+    real(dp), intent(in) :: a_super(3,3),tol
+    integer, intent(in) :: grid_override(3)
+    integer, intent(out) :: ierr
+    character(len=*), intent(out) :: message
+    real(dp) :: inv(3,3),recip(3,3),reduced(3,3),qr(3,3),rr(3,3),alias(3,3)
+    real(dp) :: shortest,alias_short,alpha,rin,volume,bandwidth,point(3),d2,sample,needed
+    integer :: ng(3),i,j,k,axis,iteration,stat
+    integer(int64) :: count,memory
+    logical :: ok
+    complex(dp), allocatable :: line(:)
+
+    ierr=0; message=''
+    if (ready) then
+      if (all(a_super==lattice).and.tol==saved_tol.and.all(grid_override==requested_grid)) then
+        message='WS MIC cache reused; Fourier face and finite-density convergence still required'
+        return
+      endif
+    endif
+    call ws_reset()
+    if (.not.all(ieee_is_finite(a_super)).or..not.ieee_is_finite(tol)) then
+      ierr=2; message='WS: nonfinite lattice or tolerance'; return
+    endif
+    if (tol<1.0e-14_dp.or.tol>=0.1_dp.or.any(grid_override<0)) then
+      ierr=2; message='WS: require 1e-14 <= tol < 0.1 and nonnegative grid dimensions'; return
+    endif
+    call inverse3(a_super,inv,volume,ok)
+    if (.not.ok) then
+      ierr=3; message='WS: singular, nonfinite or numerically ill-conditioned lattice'; return
+    endif
+    call reduce_qr(a_super,reduced,qr,rr,ok)
+    if (.not.ok) then
+      ierr=3; message='WS: lattice reduction failed; extreme conditioning or integer transform'; return
+    endif
+    call shortest_vector(reduced,qr,rr,shortest,ok)
+    if (.not.ok) then
+      ierr=3; message='WS: shortest-vector enumeration could not be certified'; return
+    endif
+    rin=0.5_dp*shortest
+    alpha=sqrt(-log(tol))/rin
+    bandwidth=-2*log(tol)/rin
+    recip=2*pi*transpose(inv)
+    do axis=1,3
+      ! The physical smooth bandwidth must also fit ws_get's rectangular
+      ! coefficient-index box, including explicitly supplied skew grids.
+      needed=bandwidth*sqrt(sum(a_super(:,axis)**2))/pi
+      if (grid_override(axis)>0) then
+        ng(axis)=grid_override(axis)
+        if (.not.power_two(ng(axis))) then
+          ierr=4; message='WS: explicit grid dimensions must be powers of two'; return
+        endif
+        if (real(ng(axis),dp)<=needed) then
+          ierr=4; message='WS: explicit grid cannot contain the physical MIC bandwidth in its index box'; return
+        endif
+      else
+        if (needed>real(memory_limit/16,dp)) then
+          ierr=4; message='WS: automatic grid exceeds the 512 MiB memory cap'; return
+        endif
+        ng(axis)=8
+        do while (real(ng(axis),dp)<=needed)
+          ng(axis)=2*ng(axis)
+        enddo
+      endif
+    enddo
+    ok=.false.
+    do iteration=1,30
+      call grid_memory(ng,count,memory,ok)
+      if (.not.ok) then
+        ierr=4; message='WS: grid exceeds the 512 MiB per-process memory cap'; return
+      endif
+      do axis=1,3
+        alias(:,axis)=real(ng(axis),dp)*recip(:,axis)
+      enddo
+      call lattice_shortest(alias,alias_short,ok)
+      if (.not.ok) then
+        ierr=3; message='WS: reciprocal alias-lattice certification failed'; return
+      endif
+      if (alias_short/2>bandwidth*(1+1.0e-12_dp)) exit
+      if (all(grid_override>0)) then
+        ierr=4; message='WS: explicit grid fails the MIC Nyquist bandwidth requirement'; return
+      endif
+      do axis=1,3
+        if (grid_override(axis)==0) ng(axis)=2*ng(axis)
+      enddo
+    enddo
+    if (iteration>30) then
+      ierr=4; message='WS: automatic grid did not reach the MIC bandwidth'; return
+    endif
+    allocate(coefficients(ng(1),ng(2),ng(3)),line(maxval(ng)),stat=stat)
+    if (stat/=0) then
+      call ws_reset()
+      ierr=4; message='WS: allocation failed within declared memory cap'; return
+    endif
+    do k=0,ng(3)-1
+      do j=0,ng(2)-1
+        do i=0,ng(1)-1
+          point=a_super(:,1)*(real(i,dp)/ng(1))+a_super(:,2)*(real(j,dp)/ng(2)) &
+                +a_super(:,3)*(real(k,dp)/ng(3))
+          call closest_squared(point,reduced,qr,rr,d2,ok)
+          if (.not.ok) then
+            deallocate(line)
+            call ws_reset()
+            ierr=3; message='WS: exact minimum-image enumeration failed'; return
+          endif
+          if (d2<=tiny(1.0_dp)) then
+            sample=2*alpha/sqrt(pi)
+          else
+            sample=erf(alpha*sqrt(d2))/sqrt(d2)
+          endif
+          coefficients(i+1,j+1,k+1)=cmplx(sample,0.0_dp,dp)
+        enddo
+      enddo
+    enddo
+    do k=1,ng(3)
+      do j=1,ng(2)
+        call fft_line(coefficients(:,j,k))
+      enddo
+    enddo
+    do k=1,ng(3)
+      do i=1,ng(1)
+        line(:ng(2))=coefficients(i,:,k)
+        call fft_line(line(:ng(2)))
+        coefficients(i,:,k)=line(:ng(2))
+      enddo
+    enddo
+    do j=1,ng(2)
+      do i=1,ng(1)
+        line(:ng(3))=coefficients(i,j,:)
+        call fft_line(line(:ng(3)))
+        coefficients(i,j,:)=line(:ng(3))
+      enddo
+    enddo
+    coefficients=coefficients*(volume/real(count,dp))
+    deallocate(line)
+    lattice=a_super; saved_tol=tol; requested_grid=grid_override
+    shape_saved=ng; alpha_saved=alpha; rin_saved=rin; volume_saved=volume
+    bytes_saved=16_int64*count ! retained cache; peak additionally has a max(ng) complex work line
+    ready=.true.
+    message='WS MIC ready; tol controls smooth bandwidth; refine FFT for WS-face/coefficient convergence'
+  end subroutine
+
+  subroutine ws_get(qcart,value,ierr)
+    real(dp), intent(in) :: qcart(3)
+    real(dp), intent(out) :: value
+    integer, intent(out) :: ierr
+    real(dp) :: phase(3),q2,x,comm_tolerance
+    integer(int64) :: modes(3)
+    integer :: idx(3)
+    value=0; ierr=0
+    if (.not.ready) then
+      ierr=1; return
+    endif
+    if (.not.all(ieee_is_finite(qcart))) then
+      ierr=2; return
+    endif
+    phase=matmul(transpose(lattice),qcart)/(2*pi)
+    if (maxval(abs(phase))>1.0e12_dp.or..not.all(ieee_is_finite(phase))) then
+      ierr=5; return
+    endif
+    modes=nint(phase,kind=int64)
+    comm_tolerance=1.0e-7_dp+64*epsilon(1.0_dp)*maxval(abs(phase))
+    if (maxval(abs(phase-real(modes,dp)))>comm_tolerance) then
+      ierr=5; return
+    endif
+    q2=sum(qcart**2)
+    if (all(modes==0)) then
+      value=pi/alpha_saved**2
+    else
+      x=q2/(4*alpha_saved**2)
+      if (x<1.0e-5_dp) then
+        value=pi/alpha_saved**2*(1-x/2+x*x/6-x*x*x/24)
+      else
+        value=4*pi*(1-exp(-x))/q2
+      endif
+    endif
+    if (any(abs(modes)>=int(shape_saved/2,int64))) return
+    idx=int(modulo(modes,int(shape_saved,int64)))+1
+    value=value+real(coefficients(idx(1),idx(2),idx(3)),dp)
+  end subroutine
+
+  logical function power_two(n)
+    integer, intent(in) :: n
+    power_two=.false.
+    if (n<2) return
+    power_two=iand(n,n-1)==0
+  end function
+
+  subroutine grid_memory(ng,count,bytes,ok)
+    integer, intent(in) :: ng(3)
+    integer(int64), intent(out) :: count,bytes
+    logical, intent(out) :: ok
+    integer :: i
+    count=1; bytes=0; ok=.false.
+    do i=1,3
+      if (ng(i)<2) return
+      if (count>memory_limit/(16_int64*int(ng(i),int64))) return
+      count=count*int(ng(i),int64)
+    enddo
+    bytes=16_int64*(count+int(maxval(ng),int64))
+    ok=bytes<=memory_limit
+  end subroutine
+
+  subroutine inverse3(a,inv,volume,ok)
+    real(dp), intent(in) :: a(3,3)
+    real(dp), intent(out) :: inv(3,3),volume
+    logical, intent(out) :: ok
+    real(dp) :: det,scale
+    inv(1,:)=cross(a(:,2),a(:,3))
+    inv(2,:)=cross(a(:,3),a(:,1))
+    inv(3,:)=cross(a(:,1),a(:,2))
+    det=dot_product(a(:,1),inv(1,:)); volume=abs(det)
+    scale=sqrt(sum(a(:,1)**2)*sum(a(:,2)**2)*sum(a(:,3)**2))
+    ok=ieee_is_finite(volume).and.ieee_is_finite(scale).and.scale>tiny(1.0_dp)
+    if (.not.ok) return
+    ok=volume>1.0e-14_dp*scale
+    if (.not.ok) return
+    inv=inv/det
+    ok=all(ieee_is_finite(inv)).and.sqrt(sum(a*a)*sum(inv*inv))<1.0e10_dp
+  end subroutine
+
+  function cross(a,b) result(c)
+    real(dp), intent(in) :: a(3),b(3)
+    real(dp) :: c(3)
+    c=[a(2)*b(3)-a(3)*b(2),a(3)*b(1)-a(1)*b(3),a(1)*b(2)-a(2)*b(1)]
+  end function
+
+  subroutine orthogonalize(b,star,mu,norm2,ok)
+    real(dp), intent(in) :: b(3,3)
+    real(dp), intent(out) :: star(3,3),mu(3,3),norm2(3)
+    logical, intent(out) :: ok
+    integer :: i,j
+    star=0; mu=0; norm2=0; ok=.false.
+    do i=1,3
+      star(:,i)=b(:,i)
+      do j=1,i-1
+        mu(i,j)=dot_product(b(:,i),star(:,j))/norm2(j)
+        star(:,i)=star(:,i)-mu(i,j)*star(:,j)
+      enddo
+      norm2(i)=sum(star(:,i)**2)
+      if (.not.ieee_is_finite(norm2(i)).or.norm2(i)<=tiny(1.0_dp)) return
+    enddo
+    ok=.true.
+  end subroutine
+
+  subroutine reduce_qr(a,b,q,r,ok)
+    ! LLL with explicit integral unimodular column operations, followed by QR.
+    real(dp), intent(in) :: a(3,3)
+    real(dp), intent(out) :: b(3,3),q(3,3),r(3,3)
+    logical, intent(out) :: ok
+    real(dp) :: star(3,3),mu(3,3),norm2(3)
+    integer(int64) :: transform(3,3),column(3),m
+    integer :: k,j,iteration
+    transform=0
+    do k=1,3
+      transform(k,k)=1
+    enddo
+    b=a; k=2; iteration=0
+    do while (k<=3)
+      iteration=iteration+1
+      if (iteration>1000) then
+        ok=.false.; return
+      endif
+      call orthogonalize(b,star,mu,norm2,ok)
+      if (.not.ok) return
+      do j=k-1,1,-1
+        if (abs(mu(k,j))>1.0e8_dp) then
+          ok=.false.; return
+        endif
+        m=nint(mu(k,j),kind=int64)
+        if (m==0) cycle
+        column=transform(:,k)-m*transform(:,j)
+        if (maxval(abs(column))>100000000_int64) then
+          ok=.false.; return
+        endif
+        transform(:,k)=column
+        b=matmul(a,real(transform,dp))
+        call orthogonalize(b,star,mu,norm2,ok)
+        if (.not.ok) return
+      enddo
+      if (norm2(k)>=(0.75_dp-mu(k,k-1)**2)*norm2(k-1)) then
+        k=k+1
+      else
+        column=transform(:,k); transform(:,k)=transform(:,k-1); transform(:,k-1)=column
+        b=matmul(a,real(transform,dp)); k=max(2,k-1)
+      endif
+    enddo
+    call orthogonalize(b,star,mu,norm2,ok)
+    if (.not.ok) return
+    do k=1,3
+      q(:,k)=star(:,k)/sqrt(norm2(k))
+    enddo
+    r=matmul(transpose(q),b)
+    r(2,1)=0; r(3,1)=0; r(3,2)=0
+    ok=all(ieee_is_finite(r)).and.maxval(abs(matmul(transpose(q),q)-identity3()))<1.0e-8_dp
+  end subroutine
+
+  function identity3() result(a)
+    real(dp) :: a(3,3)
+    integer :: i
+    a=0
+    do i=1,3
+      a(i,i)=1
+    enddo
+  end function
+
+  subroutine lattice_shortest(a,length,ok)
+    real(dp), intent(in) :: a(3,3)
+    real(dp), intent(out) :: length
+    logical, intent(out) :: ok
+    real(dp) :: b(3,3),q(3,3),r(3,3)
+    call reduce_qr(a,b,q,r,ok)
+    if (ok) call shortest_vector(b,q,r,length,ok)
+  end subroutine
+
+  subroutine shortest_vector(b,q,r,length,ok)
+    real(dp), intent(in) :: b(3,3),q(3,3),r(3,3)
+    real(dp), intent(out) :: length
+    logical, intent(out) :: ok
+    real(dp) :: best,zero(3)
+    integer(int64) :: n(3)
+    best=minval(sum(b*b,dim=1)); zero=0; n=0
+    call sphere_search(r,zero,best,n,.true.,ok)
+    length=sqrt(best)
+  end subroutine
+
+  subroutine closest_squared(point,b,q,r,d2,ok)
+    real(dp), intent(in) :: point(3),b(3,3),q(3,3),r(3,3)
+    real(dp), intent(out) :: d2
+    logical, intent(out) :: ok
+    real(dp) :: y(3),residual(3)
+    integer(int64) :: n(3)
+    integer :: k
+    y=matmul(transpose(q),point); n=0
+    do k=3,1,-1
+      n(k)=nint((y(k)-dot_product(r(k,:),real(n,dp)))/r(k,k),kind=int64)
+    enddo
+    residual=point-matmul(b,real(n,dp)); d2=sum(residual**2)
+    call sphere_search(r,y,d2,n,.false.,ok)
+  end subroutine
+
+  subroutine sphere_search(r,y,best,n,exclude_zero,ok)
+    ! Complete QR sphere enumeration. Bounds are padded for floating roundoff;
+    ! no predetermined neighbour shell or component-wise image wrapping.
+    real(dp), intent(in) :: r(3,3),y(3)
+    real(dp), intent(inout) :: best
+    integer(int64), intent(inout) :: n(3)
+    logical, intent(in) :: exclude_zero
+    logical, intent(out) :: ok
+    integer :: visited
+    visited=0; ok=.true.
+    call visit(3,0.0_dp)
+  contains
+    recursive subroutine visit(level,partial)
+      integer, intent(in) :: level
+      real(dp), intent(in) :: partial
+      real(dp) :: center,radius,remaining,term,padding,safety
+      integer(int64) :: lo,hi,j
+      if (.not.ok) return
+      visited=visited+1
+      if (visited>1000000) then
+        ok=.false.; return
+      endif
+      if (level==0) then
+        if (exclude_zero.and.all(n==0)) return
+        best=min(best,partial)
+        return
+      endif
+      safety=256*epsilon(1.0_dp)*max(best,sum(y*y),sum(r*r),tiny(1.0_dp))
+      remaining=best-partial+safety
+      if (remaining<0) return
+      center=(y(level)-dot_product(r(level,level+1:3),real(n(level+1:3),dp)))/r(level,level)
+      radius=sqrt(max(0.0_dp,remaining))/abs(r(level,level))
+      padding=128*epsilon(1.0_dp)*max(1.0_dp,abs(center),radius)
+      if (abs(center)+radius>1.0e12_dp) then
+        ok=.false.; return
+      endif
+      lo=ceiling(center-radius-padding,kind=int64)
+      hi=floor(center+radius+padding,kind=int64)
+      do j=lo,hi
+        n(level)=j
+        term=r(level,level)*(real(j,dp)-center)
+        call visit(level-1,partial+term*term)
+      enddo
+    end subroutine
+  end subroutine
+
+  subroutine fft_line(data)
+    complex(dp), intent(inout) :: data(:)
+    complex(dp) :: temp,w,step
+    integer :: n,i,j,bit,width,start,k
+    n=size(data); j=0
+    do i=0,n-1
+      if (i<j) then
+        temp=data(i+1); data(i+1)=data(j+1); data(j+1)=temp
+      endif
+      bit=n/2
+      do while (bit>0)
+        if (iand(j,bit)==0) exit
+        j=ieor(j,bit); bit=bit/2
+      enddo
+      j=ieor(j,bit)
+    enddo
+    width=2
+    do while (width<=n)
+      step=cmplx(cos(-2*pi/width),sin(-2*pi/width),dp)
+      do start=1,n,width
+        w=cmplx(1.0_dp,0.0_dp,dp)
+        do k=0,width/2-1
+          temp=w*data(start+k+width/2)
+          data(start+k+width/2)=data(start+k)-temp
+          data(start+k)=data(start+k)+temp
+          w=w*step
+        enddo
+      enddo
+      width=2*width
+    enddo
+  end subroutine
+end module
